{
	"name": "tcad-scraper",
	"version": "1.0.0",
	"description": "A web scraping tool built with TypeScript for extracting property tax information from the Travis Central Appraisal District (TCAD) website.",
	"type": "module",
	"scripts": {
		"generate:constants": "npx tsx scripts/generate-build-constants.ts",
		"predev": "npm run generate:constants",
		"dev": "vite",
		"prebuild": "npm run generate:constants",
		"build": "tsc && vite build",
		"preview": "vite preview",
		"lint": "biome check .",
		"test": "vitest",
		"test:ui": "vitest --ui",
		"test:coverage": "vitest --coverage",
		"test:e2e": "playwright test",
		"test:e2e:ui": "playwright test --ui",
		"repomix": "bash scripts/repomix/repomix-regen.sh"
	},
	"keywords": [],
	"author": "",
	"license": "ISC",
	"dependencies": {
		"@playwright/test": "^1.56.1",
		"@sentry/react": "^10.27.0",
		"@types/node": "^24.9.2",
		"@vitejs/plugin-react": "^5.0.4",
		"mixpanel-browser": "^2.72.0",
		"react": "^19.2.0",
		"react-dom": "^19.2.0",
		"vite": "^7.1.11"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.11.1",
		"@biomejs/biome": "2.3.8",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/react": "^16.3.0",
		"@testing-library/user-event": "^14.6.1",
		"@types/mixpanel-browser": "^2.60.0",
		"@types/react": "^19.2.2",
		"@types/react-dom": "^19.2.2",
		"@vitest/coverage-v8": "^4.1.0",
		"@vitest/ui": "^4.0.8",
		"jsdom": "^27.1.0",
		"tsx": "^4.20.6",
		"typescript": "^5.9.3",
		"vitest": "^4.0.8"
	},
	"optionalDependencies": {
		"@esbuild/linux-x64": "^0.25.0",
		"@rollup/rollup-darwin-arm64": "^4.53.3",
		"@rollup/rollup-linux-x64-gnu": "^4.53.3",
		"fsevents": "^2.3.3"
	}
}
