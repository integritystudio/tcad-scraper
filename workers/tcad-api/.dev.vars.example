# Copy to .dev.vars (never commit .dev.vars)
# These secrets are injected by wrangler dev.
# The database is D1, bound via wrangler.toml [[d1_databases]] — no DATABASE_URL.
API_KEY=your-api-key
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
SENTRY_DSN=https://...@sentry.io/...
TOKEN_WORKER_URL=https://tcad-token-refresh.your-account.workers.dev
TOKEN_WORKER_SECRET=your-worker-secret
