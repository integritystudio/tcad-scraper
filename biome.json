{
	"$schema": "https://biomejs.dev/schemas/2.3.8/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"includes": [
			"**",
			"!!**/dist",
			"!!docs/repo-summary.json",
			"!!server/data/*.json",
			"!!scripts/lib/*.js",
			"!!server/src/**/*.js",
			"!!utils/*.js",
			"!!.claude",
			"!!workers/tcad-api/worker-configuration.d.ts"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true,
			"complexity": {
				"noArguments": "on"
			},
			"a11y": {
				"noSvgWithoutTitle": "warn",
				"useButtonType": "warn",
				"useSemanticElements": "warn",
				"useAriaPropsSupportedByRole": "warn"
			},
			"suspicious": {
				"useIterableCallbackReturn": "warn",
				"noExplicitAny": "warn"
			},
			"style": {
				"noNonNullAssertion": "warn"
			},
			"correctness": {
				"noUnusedVariables": "error",
				"noInvalidUseBeforeDeclaration": "error",
				"useExhaustiveDependencies": "error"
			}
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		}
	},
	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	},
	"overrides": [
		{
			"includes": ["**/*.module.css"],
			"css": {
				"parser": {
					"cssModules": true
				}
			}
		},
		{
			"includes": ["index.html"],
			"linter": {
				"rules": {
					"complexity": {
						"noArguments": "off"
					}
				}
			}
		},
		{
			"includes": ["server/src/**/*.ts", "shared/**/*.ts"],
			"linter": {
				"rules": {
					"suspicious": {
						"noExplicitAny": "off",
						"useIterableCallbackReturn": "off"
					},
					"style": {
						"noNonNullAssertion": "off"
					},
					"correctness": {
						"noUnusedVariables": "off"
					}
				}
			}
		},
		{
			"includes": ["**/*.test.ts", "**/__tests__/*.ts"],
			"linter": {
				"rules": {
					"suspicious": {
						"noExplicitAny": "off",
						"useIterableCallbackReturn": "off"
					},
					"style": {
						"noNonNullAssertion": "off"
					},
					"correctness": {
						"noConstructorReturn": "off"
					}
				}
			}
		}
	]
}
