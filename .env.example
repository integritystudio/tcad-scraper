# =============================================================================
# TCAD Scraper — Environment Variables
#
# Secrets are managed via Doppler (project: integrity-studio, config: dev/prd).
# Prefer `doppler run -- <command>` over a local .env file.
# Workers secrets are set separately via `wrangler secret put` (see README).
# =============================================================================

# -----------------------------------------------------------------------------
# Scripts (scripts/*.ts — enqueue, backfill, build constants)
# -----------------------------------------------------------------------------

# Workers API key, sent as the x-api-key header (Workers env.API_KEY value)
TCAD_API_KEY=

# Cloudflare D1 REST access (token "tcad-d1-query": D1 Read/Write/Metadata Read).
# Used by scripts/lib/d1-prisma.ts and scripts/generate-build-constants.ts.
CLOUDFLARE_D1_TOKEN=
# Optional overrides — defaults are hardcoded in the scripts
CLOUDFLARE_ACCOUNT_ID=b3868dd0fd5c0faa7d98aa325a9c2377
CLOUDFLARE_DATABASE_ID=451d4356-10d1-4c1d-adf9-4d4297636343

# Tax year targeted by enqueue/backfill scripts
TCAD_YEAR=2025

# Fallback property count for the build when D1 is unreachable
FALLBACK_PROPERTY_COUNT=170320

# -----------------------------------------------------------------------------
# Frontend (Vite, read via import.meta.env at build time)
# -----------------------------------------------------------------------------

# API base URL (production default: https://api.alephatx.info/api;
# local Workers dev: http://localhost:8787/api)
VITE_API_URL=http://localhost:8787/api

# Optional analytics/monitoring
VITE_MIXPANEL_TOKEN=
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=development

# -----------------------------------------------------------------------------
# Legacy server/ (Express — reference only, not in the production path)
# -----------------------------------------------------------------------------
# The legacy backend reads many more vars (DATABASE_URL, REDIS_URL, JWT_*,
# HELMET_*, QUEUE_*, LOG_*); see server/src/config/index.ts if you need to run
# it. None of these are used by the Workers API or the frontend.
# DATABASE_URL=postgresql://user:password@localhost:5432/tcad
# PORT=3001
# ANTHROPIC_API_KEY=
# SENTRY_DSN=
