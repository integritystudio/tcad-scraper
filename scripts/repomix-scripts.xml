27: 		let successCount = 0;
28: 		let failCount = 0;
29: 		for (const term of terms) {
30: 			try {
31: 				const job = await scraperQueue.add(
32: 					"scrape-properties",
33: 					{
34: 						searchTerm: term,
35: 						userId,
36: 						scheduled: true,
37: 					},
38: 					{
39: 						attempts: 3,
40: 						backoff: {
41: 							type: "exponential",
42: 							delay: 2000,
43: 						},
44: 						...(priority !== undefined && { priority }),
45: 						removeOnComplete: 100,
46: 						removeOnFail: 50,
47: 					},
48: 				);
49: 				successCount++;
50: 				logger.info(
51: 					`✅ [${successCount}/${terms.length}] Queued: "${term}" (Job ID: ${job.id})`,
52: 				);
53: 			} catch (error) {
54: 				failCount++;
