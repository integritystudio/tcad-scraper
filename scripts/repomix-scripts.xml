307: 	}
308: 	async monitorProgress(): Promise<void> {
309: 		logger.info("\n╔════════════════════════════════════════════════════════╗");
310: 		logger.info("║          MONITORING PROGRESS                           ║");
311: 		logger.info("╚════════════════════════════════════════════════════════╝\n");
312: 		const checkInterval = 30000;
313: 		while (true) {
314: 			await this.delay(checkInterval);
315: 			const [waiting, active, completed, failed] = await Promise.all([
316: 				scraperQueue.getWaitingCount(),
317: 				scraperQueue.getActiveCount(),
318: 				scraperQueue.getCompletedCount(),
319: 				scraperQueue.getFailedCount(),
320: 			]);
321: 			const elapsed = Math.floor((Date.now() - this.stats.startTime) / 1000);
322: 			const minutes = Math.floor(elapsed / 60);
323: 			const seconds = elapsed % 60;
324: 			const totalProperties = await prisma.property.count();
325: 			const recentProperties = await prisma.property.count({
326: 				where: {
