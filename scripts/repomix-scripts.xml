328: 						gte: new Date(Date.now() - 300000),
329: 					},
330: 				},
331: 			});
332: 			const progress = ((completed + failed) / this.stats.totalQueued) * 100;
333: 			logger.info(`
334: ┌─────────────────────────────────────────────────────────┐
335: │ Time: ${minutes}m ${seconds}s | Progress: ${progress.toFixed(1)}%
336: ├─────────────────────────────────────────────────────────┤
