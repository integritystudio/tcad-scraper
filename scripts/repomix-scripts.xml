<file path="migrate-to-logger.ts">
 1: #!/usr/bin/env tsx
 2: import * as fs from "node:fs";
 3: import * as path from "node:path";
 4: function migrateFile(filePath: string): void {
 5: 	const content = fs.readFileSync(filePath, "utf-8");
 6: 	const lines = content.split("\n");
 7: 	let hasImport = false;
 8: 	let lastImportIndex = -1;
 9: 	for (let i = 0; i < lines.length; i++) {
10: 		const line = lines[i];
11: 		if (
12: 			line.includes("import") &&
13: 			line.includes("logger") &&
14: 			line.includes("../lib/logger")
15: 		) {
16: 			hasImport = true;
17: 			break;
18: 		}
19: 		if (line.startsWith("import ") && !line.includes("type")) {
20: 			lastImportIndex = i;
21: 		}
22: 	}
23: 	let modified = content;
24: 	const replacements: { pattern: RegExp; replacement: string }[] = [
25: 		{ pattern: /console\.error\(/g, replacement: "logger.error(" },
26: 		{ pattern: /console\.warn\(/g, replacement: "logger.warn(" },
27: 		{ pattern: /console\.info\(/g, replacement: "logger.info(" },
28: 		{ pattern: /console\.debug\(/g, replacement: "logger.debug(" },
29: 		{ pattern: /console\.log\(/g, replacement: "logger.info(" },
30: 	];
31: 	replacements.forEach(({ pattern, replacement }) => {
32: 		modified = modified.replace(pattern, replacement);
33: 	});
34: 	if (!hasImport && modified !== content) {
35: 		const lines = modified.split("\n");
36: 		const insertIndex = lastImportIndex >= 0 ? lastImportIndex + 1 : 0;
37: 		const fileDir = path.dirname(filePath);
38: 		const loggerPath = path.join(__dirname, "../lib/logger");
39: 		const relativePath = path.relative(fileDir, loggerPath).replace(/\\/g, "/");
40: 		const importPath = relativePath.startsWith(".")
41: 			? relativePath
42: 			: `./${relativePath}`;
43: 		lines.splice(insertIndex, 0, `import logger from '${importPath}';`);
44: 		modified = lines.join("\n");
45: 	}
46: 	if (modified !== content) {
47: 		fs.writeFileSync(filePath, modified, "utf-8");
48: 		console.log(`✅ Migrated: ${filePath}`);
49: 	} else {
50: 		console.log(`⏭️  No changes: ${filePath}`);
51: 	}
52: }
53: const filePath = process.argv[2];
54: if (!filePath) {
55: 	console.error("Usage: tsx migrate-to-logger.ts <file-path>");
56: 	process.exit(1);
57: }
58: if (!fs.existsSync(filePath)) {
59: 	console.error(`File not found: ${filePath}`);
60: 	process.exit(1);
61: }
62: try {
63: 	migrateFile(filePath);
64: } catch (error) {
65: 	console.error("Migration failed:", error);
66: 	process.exit(1);
67: }
</file>

