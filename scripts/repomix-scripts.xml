<file path="utils/test-scripts/test-enqueue.ts">
 1: import { config } from "../../../config";
 2: import { prisma } from "../../../lib/prisma";
 3: import { scraperQueue } from "../../../queues/scraper.queue";
 4: import { getErrorMessage } from "../../../utils/error-helpers";
 5: const POLL_INTERVAL_MS = 5_000;
 6: const MAX_WAIT_MS = 300_000;
 7: const FALLBACK_TERMS = [
 8:   "Joseph", "Taylor", "Charles", "Carol", "Steven", "Juan", "James", "Mary",
 9:   "John", "Patricia", "Robert", "Elizabeth", "David", "Barbara", "Richard",
10:   "Susan", "Thomas", "Sarah", "Daniel", "Lisa",
11: ];
12: async function main() {
13:   const raw = parseInt(process.argv[2] || "10", 10);
14:   const requested = Math.min(Number.isNaN(raw) ? 10 : raw, FALLBACK_TERMS.length);
15:   const alreadySearched = await prisma.searchTermAnalytics.findMany({
16:     where: { searchTerm: { in: FALLBACK_TERMS } },
17:     select: { searchTerm: true },
18:   });
19:   const searched = new Set(alreadySearched.map((r) => r.searchTerm));
20:   const fresh = FALLBACK_TERMS.filter((t) => !searched.has(t));
21:   const terms = fresh.slice(0, requested);
22:   if (searched.size > 0) {
23:     const skipped = FALLBACK_TERMS.filter((t) => searched.has(t));
24:     console.log(`\nSkipping ${skipped.length} already-searched terms: ${skipped.join(", ")}`);
25:   }
26:   if (terms.length === 0) {
27:     console.log("\nNo unsearched terms remaining in the pool.");
28:     await prisma.$disconnect();
29:     process.exit(0);
30:   }
31:   console.log(`\n=== Enqueuing ${terms.length} test jobs (year=${config.scraper.tcadYear}) ===\n`);
32:   const jobIds: { id: string; term: string }[] = [];
33:   for (const term of terms) {
34:     const job = await scraperQueue.add(
35:       "scrape-properties",
36:       { searchTerm: term, userId: "test-enqueue", scheduled: true },
37:       { attempts: 3, backoff: { type: "exponential", delay: 2000 }, removeOnComplete: false, removeOnFail: false },
38:     );
39:     jobIds.push({ id: job.id.toString(), term });
40:     console.log(`  Enqueued: "${term}" -> job ${job.id}`);
41:   }
42:   console.log(`\nWaiting for ${jobIds.length} jobs...\n`);
43:   const start = Date.now();
44:   while (Date.now() - start < MAX_WAIT_MS) {
45:     const states = await Promise.all(
46:       jobIds.map(async (j) => {
47:         const job = await scraperQueue.getJob(j.id);
48:         return job ? await job.getState() : "unknown";
49:       }),
50:     );
51:     const completed = states.filter((s) => s === "completed").length;
52:     const failed = states.filter((s) => s === "failed").length;
53:     const active = states.filter((s) => s === "active").length;
54:     const waiting = states.filter((s) => s === "waiting").length;
55:     console.log(`  [${Math.round((Date.now() - start) / 1000)}s] completed=${completed} failed=${failed} active=${active} waiting=${waiting}`);
56:     if (completed + failed >= jobIds.length) break;
57:     await new Promise((r) => setTimeout(r, POLL_INTERVAL_MS));
58:   }
59:   console.log("\n=== RESULTS ===\n");
60:   for (const { id, term } of jobIds) {
61:     const job = await scraperQueue.getJob(id);
62:     if (!job) { console.log(`  "${term}": job not found`); continue; }
63:     const state = await job.getState();
64:     const rv = job.returnvalue;
65:     if (state === "completed") {
66:       console.log(`  "${term}" -> OK  count=${rv?.count ?? "?"} new=${rv?.newProperties ?? "?"} updated=${rv?.updatedProperties ?? "?"}`);
67:     } else if (state === "failed") {
68:       console.log(`  "${term}" -> FAILED: ${job.failedReason}`);
69:     } else {
70:       console.log(`  "${term}" -> ${state}`);
71:     }
72:   }
73:   console.log("\n=== VALUE CHECK (last 20 properties from these terms) ===\n");
74:   const recent = await prisma.property.findMany({
75:     where: { searchTerm: { in: terms }, year: config.scraper.tcadYear },
76:     orderBy: { scrapedAt: "desc" },
77:     take: 20,
78:     select: { propertyId: true, name: true, appraisedValue: true, assessedValue: true, year: true, searchTerm: true },
79:   });
80:   for (const p of recent) {
81:     console.log(`  pid=${p.propertyId} year=${p.year} appraised=${p.appraisedValue} assessed=${p.assessedValue} term="${p.searchTerm}"`);
82:   }
83:   const zeros = recent.filter((p) => p.appraisedValue === 0).length;
84:   const nonZeros = recent.filter((p) => p.appraisedValue > 0).length;
85:   console.log(`\n  Summary: ${nonZeros} with values, ${zeros} with appraised=0 (out of ${recent.length})`);
86:   await scraperQueue.close();
87:   await prisma.$disconnect();
88:   process.exit(0);
89: }
90: main().catch((err) => {
91:   console.error("Fatal:", getErrorMessage(err));
92:   process.exit(1);
93: });
