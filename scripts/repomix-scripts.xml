196: 	const searched = await getSearchedTerms();
197: 	const candidates = TERM_POOL.filter(
198: 		(t) => !searched.has(t.toLowerCase()) && !NUMERIC_ONLY.test(t),
199: 	);
200: 	logger.info(`Already searched: ${searched.size} terms`);
201: 	logger.info(`Unsearched candidates: ${candidates.length}`);
202: 	if (candidates.length === 0) {
203: 		logger.warn("No unsearched candidates — all terms already in analytics");
204: 		await prisma.$disconnect();
205: 		process.exit(1);
206: 	}
207: 	if (dryRun) {
208: 		const shown = termLimit === Infinity ? candidates : candidates.slice(0, termLimit);
209: 		for (const t of shown) logger.info(`  "${t}"`);
210: 		logger.info(`\nDry run complete. ${shown.length} terms would be processed.`);
211: 		await prisma.$disconnect();
212: 		return;
213: 	}
214: 	let running = true;
215: 	process.on("SIGINT", () => { running = false; logger.info("Shutting down after current term..."); });
216: 	process.on("SIGTERM", () => { running = false; });
217: 	let termsProcessed = 0;
218: 	if (noWait) {
219: 		for (const term of candidates) {
220: 			if (!running) break;
221: 			if (termsProcessed >= termLimit) break;
222: 			const job = await scraperQueue.add(
223: 				"scrape-properties",
224: 				{ searchTerm: term, userId: "40k-sprint", scheduled: true },
225: 				{
226: 					attempts: 3,
227: 					backoff: { type: "exponential", delay: 2000 },
228: 					priority: SPRINT_PRIORITY,
229: 					removeOnComplete: 100,
230: 					removeOnFail: 50,
231: 				},
232: 			);
233: 			termsProcessed++;
234: 			logger.info(`[${termsProcessed}/${Math.min(candidates.length, termLimit)}] Enqueued "${term}" — job ${String(job.id ?? "unknown")}`);
235: 		}
236: 		const elapsed = Math.floor((Date.now() - startTime) / 1000);
237: 		logger.info("\n=== Batch Enqueue Complete ===");
238: 		logger.info(`Enqueued: ${termsProcessed} terms in ${elapsed}s`);
239: 		logger.info(`Worker will process them in the background.`);
240: 	} else {
241: 		let totalNew = 0;
242: 		let consecutiveZeros = 0;
243: 		let termsWithYield = 0;
244: 		for (const term of candidates) {
245: 			if (!running) break;
246: 			if (termsProcessed >= termLimit) {
247: 				logger.info(`Term limit reached (${termLimit}).`);
248: 				break;
249: 			}
250: 			if (termLimit === Infinity && totalNew >= NEW_PROPERTY_TARGET) {
251: 				logger.info(`Target reached! ${totalNew.toLocaleString()} new properties.`);
252: 				break;
253: 			}
254: 			if (consecutiveZeros >= MAX_CONSECUTIVE_ZEROS) {
255: 				logger.info(`Stopping: ${MAX_CONSECUTIVE_ZEROS} consecutive zero-yield terms.`);
256: 				break;
257: 			}
258: 			const countBefore = await prisma.property.count();
259: 			const job = await scraperQueue.add(
260: 				"scrape-properties",
261: 				{ searchTerm: term, userId: "40k-sprint", scheduled: true },
262: 				{
263: 					attempts: 3,
264: 					backoff: { type: "exponential", delay: 2000 },
265: 					priority: SPRINT_PRIORITY,
266: 					removeOnComplete: 100,
267: 					removeOnFail: 50,
268: 				},
269: 			);
270: 			termsProcessed++;
271: 			const jobId = String(job.id ?? "unknown");
272: 			logger.info(`[${termsProcessed}/${candidates.length}] "${term}" — job ${jobId}`);
273: 			const result = await waitForJob(jobId);
274: 			const countAfter = await prisma.property.count();
275: 			const newFromTerm = countAfter - countBefore;
276: 			totalNew += Math.max(0, newFromTerm);
277: 			if (newFromTerm > 0) {
278: 				consecutiveZeros = 0;
279: 				termsWithYield++;
280: 				logger.info(`  +${newFromTerm.toLocaleString()} new (total: +${totalNew.toLocaleString()}) [${result}]`);
281: 			} else {
282: 				consecutiveZeros++;
283: 				logger.info(`  +0 new (${consecutiveZeros}/${MAX_CONSECUTIVE_ZEROS} consecutive zeros) [${result}]`);
284: 			}
285: 		}
286: 		const elapsed = Math.floor((Date.now() - startTime) / 1000);
287: 		const finalCount = await prisma.property.count();
288: 		const minutes = Math.floor(elapsed / 60);
289: 		const seconds = elapsed % 60;
290: 		logger.info("\n=== Sprint Complete ===");
291: 		logger.info(`Runtime: ${minutes}m ${seconds}s`);
292: 		logger.info(`Terms processed: ${termsProcessed} (${termsWithYield} yielded new properties)`);
293: 		logger.info(`Properties: ${startCount.toLocaleString()} -> ${finalCount.toLocaleString()} (+${(finalCount - startCount).toLocaleString()})`);
294: 		logger.info(`Consecutive zeros at stop: ${consecutiveZeros}`);
295: 	}
296: 	await prisma.$disconnect();
297: }
298: run().catch((error) => {
299: 	logger.error(`Fatal: ${getErrorMessage(error)}`);
300: 	process.exit(1);
301: });
</file>

