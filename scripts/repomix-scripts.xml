 91: export interface TermSelectorConfig {
 92: 	tiers: Prisma.SearchTermAnalyticsWhereInput[];
 93: 	applyHighResultSplits: boolean;
 94: }
 95: const STANDARD_TIER_CONFIG: TermSelectorConfig = {
 96: 	tiers: [
 97: 		{ totalSearches: 1, successRate: 1, avgResultsPerSearch: { gte: 500 } },
 98: 		{ totalSearches: 1, successRate: 1, avgResultsPerSearch: { gte: 100 } },
 99: 		{ totalSearches: { lte: 2 }, successRate: { gte: 0.4 }, avgResultsPerSearch: { gte: 1000 } },
100: 	],
101: 	applyHighResultSplits: true,
102: };
103: export const LOW_THRESHOLD_TIER_CONFIG: TermSelectorConfig = {
104: 	tiers: [
105: 		{ totalSearches: 1, successRate: 1, avgResultsPerSearch: { gte: 20 } },
106: 		{ totalSearches: { lte: 2 }, successRate: { gte: 0.5 }, avgResultsPerSearch: { gte: 20 } },
107: 		{ totalSearches: { lte: 3 }, successRate: { gte: 0.3 }, avgResultsPerSearch: { gte: 50 } },
108: 	],
109: 	applyHighResultSplits: false,
110: };
111: const CACHE_REFRESH_INTERVAL_BATCHES = 20;
112: export class TermSelector {
113: 	private enqueuedTerms = new Set<string>();
114: 	private deduplicator = new SearchTermDeduplicator();
115: 	private optimizer: SearchTermOptimizer;
116: 	private config: TermSelectorConfig;
117: 	private blacklistLoaded = false;
118: 	private queueSeeded = false;
119: 	private cachedPropertyTermSet: Set<string> | null = null;
120: 	private cachedAllSearchedTermSet: Set<string> | null = null;
121: 	private batchCount = 0;
122: 	constructor(config?: TermSelectorConfig, optimizer?: SearchTermOptimizer) {
123: 		this.config = config ?? STANDARD_TIER_CONFIG;
124: 		this.optimizer = optimizer ?? searchTermOptimizer;
125: 	}
126: 	async getNextBatch(size: number): Promise<string[]> {
127: 		this.batchCount++;
128: 		if (this.batchCount % CACHE_REFRESH_INTERVAL_BATCHES === 0) {
129: 			this.cachedPropertyTermSet = null;
130: 			this.cachedAllSearchedTermSet = null;
131: 			logger.info(`Cache invalidated after ${this.batchCount} batches`);
132: 		}
133: 		await this.loadBlacklist();
134: 		await this.seedFromQueue();
135: 		const propertyTerms = await this.getPropertyTermSet();
136: 		const allSearched = await this.getAllSearchedTermSet();
137: 		const batch: string[] = [];
138: 		for (const tierWhere of this.config.tiers) {
139: 			if (batch.length >= size) break;
140: 			const tierResults = await this.queryTier(tierWhere, size - batch.length, propertyTerms);
141: 			batch.push(...tierResults);
142: 		}
143: 		if (batch.length < size) {
144: 			for (const term of FALLBACK_TERMS) {
145: 				if (batch.length >= size) break;
146: 				if (this.enqueuedTerms.has(term)) continue;
147: 				if (allSearched.has(term.toLowerCase())) continue;
148: 				if (this.deduplicator.shouldSkipTerm(term)) continue;
149: 				this.enqueuedTerms.add(term);
150: 				this.deduplicator.markTermAsUsed(term);
151: 				batch.push(term);
152: 			}
153: 		}
154: 		const expanded: string[] = [];
155: 		for (const term of batch) {
156: 			const splits = this.config.applyHighResultSplits ? HIGH_RESULT_TERM_SPLITS.get(term) : undefined;
157: 			if (splits) {
158: 				let added = 0;
159: 				for (const split of splits) {
160: 					if (this.enqueuedTerms.has(split)) continue;
161: 					if (allSearched.has(split.toLowerCase())) continue;
162: 					expanded.push(split);
163: 					added++;
164: 				}
165: 				if (added > 0) {
166: 					logger.info(`Expanded high-result term "${term}" → ${added} sub-queries`);
167: 				} else {
168: 					logger.info(`High-result term "${term}" all splits already searched; slot dropped`);
169: 				}
170: 			} else {
171: 				expanded.push(term);
172: 			}
173: 		}
174: 		const result = expanded.slice(0, size);
175: 		for (const term of result) {
176: 			this.enqueuedTerms.add(term);
177: 		}
178: 		if (result.length > 0) {
179: 			logger.info(`Selected ${result.length} terms: ${result.slice(0, 5).join(", ")}${result.length > 5 ? "..." : ""}`);
180: 		} else {
181: 			logger.warn("No candidate terms available from any tier or fallback");
182: 		}
183: 		return result;
184: 	}
185: 	private async queryTier(
186: 		where: Prisma.SearchTermAnalyticsWhereInput,
187: 		limit: number,
188: 		searched: Set<string>,
189: 	): Promise<string[]> {
190: 		const results = await prisma.searchTermAnalytics.findMany({
191: 			where,
192: 			orderBy: { avgResultsPerSearch: "desc" },
193: 			select: { searchTerm: true },
194: 			take: limit * 3,
195: 		});
196: 		const picked: string[] = [];
197: 		for (const row of results) {
198: 			if (picked.length >= limit) break;
199: 			const term = row.searchTerm;
200: 			if (this.enqueuedTerms.has(term)) continue;
201: 			if (searched.has(term.toLowerCase())) continue;
202: 			if (this.deduplicator.shouldSkipTerm(term)) continue;
203: 			this.enqueuedTerms.add(term);
204: 			this.deduplicator.markTermAsUsed(term);
205: 			picked.push(term);
206: 		}
207: 		return picked;
208: 	}
209: 	private async seedFromQueue(): Promise<void> {
210: 		if (this.queueSeeded) return;
211: 		try {
212: 			const [waiting, active] = await Promise.all([
213: 				scraperQueue.getWaiting(),
214: 				scraperQueue.getActive(),
215: 			]);
216: 			let seeded = 0;
217: 			for (const job of [...waiting, ...active]) {
218: 				const term = job.data?.searchTerm;
219: 				if (term && !this.enqueuedTerms.has(term)) {
220: 					this.enqueuedTerms.add(term);
221: 					seeded++;
222: 				}
223: 			}
224: 			if (seeded > 0) {
225: 				logger.info(`Seeded ${seeded} in-flight terms from queue`);
226: 			}
227: 		} catch (error) {
228: 			logger.warn(`Failed to seed from queue: ${getErrorMessage(error)}`);
229: 		}
230: 		this.queueSeeded = true;
231: 	}
232: 	private async getPropertyTermSet(): Promise<Set<string>> {
233: 		if (this.cachedPropertyTermSet) return this.cachedPropertyTermSet;
234: 		const propertyTerms = await prisma.property.groupBy({
235: 			by: ["searchTerm"],
236: 			where: { year: config.scraper.tcadYear, searchTerm: { not: null } },
237: 		});
238: 		const set = new Set<string>();
239: 		for (const r of propertyTerms) {
240: 			if (r.searchTerm) set.add(r.searchTerm.toLowerCase());
241: 		}
242: 		this.cachedPropertyTermSet = set;
243: 		return set;
244: 	}
245: 	private async getAllSearchedTermSet(): Promise<Set<string>> {
246: 		if (this.cachedAllSearchedTermSet) return this.cachedAllSearchedTermSet;
247: 		const [analyticsRows, propertyTerms] = await Promise.all([
248: 			prisma.searchTermAnalytics.findMany({
249: 				select: { searchTerm: true },
250: 			}),
251: 			this.getPropertyTermSet(),
252: 		]);
253: 		const set = new Set<string>(propertyTerms);
254: 		for (const r of analyticsRows) set.add(r.searchTerm.toLowerCase());
255: 		this.cachedAllSearchedTermSet = set;
256: 		return set;
257: 	}
258: 	private async loadBlacklist(): Promise<void> {
259: 		if (this.blacklistLoaded) return;
260: 		try {
261: 			const blacklisted = await this.optimizer.getBlacklistedTerms(3);
262: 			for (const term of blacklisted) {
263: 				this.deduplicator.forceBlacklist(term);
264: 			}
265: 			if (blacklisted.length > 0) {
266: 				logger.info(`Blacklisted ${blacklisted.length} zero-yield terms`);
267: 			}
268: 		} catch (error) {
269: 			logger.warn(`Failed to load blacklist: ${getErrorMessage(error)}`);
270: 		}
271: 		try {
272: 			const overSearched = await this.optimizer.getOverSearchedTerms(5);
273: 			for (const term of overSearched) {
274: 				this.enqueuedTerms.add(term);
275: 			}
276: 			if (overSearched.length > 0) {
277: 				logger.info(`Marked ${overSearched.length} over-searched terms as used`);
278: 			}
279: 		} catch (error) {
280: 			logger.warn(`Failed to load over-searched terms: ${getErrorMessage(error)}`);
281: 		}
282: 		this.blacklistLoaded = true;
283: 	}
284: }
285: class ContinuousBatchScraper {
286: 	private termSelector = new TermSelector();
287: 	private stats = {
288: 		totalQueued: 0,
289: 		batchesProcessed: 0,
290: 		startTime: Date.now(),
291: 		startingPropertyCount: 0,
292: 	};
293: 	private running = true;
294: 	private consecutiveZeroBatches = 0;
295: 	private lastPropertyCount = 0;
296: 	async run() {
297: 		logger.info("========================================");
298: 		logger.info("  CONTINUOUS BATCH SCRAPER (DB-driven)  ");
299: 		logger.info("========================================\n");
300: 		const pendingCount = await scraperQueue.getWaitingCount();
301: 		if (pendingCount > 0) {
302: 			await scraperQueue.clean(0, "wait");
303: 			logger.info(`Cleared ${pendingCount} pending jobs`);
304: 		}
305: 		this.stats.startingPropertyCount = await prisma.property.count({ where: { year: config.scraper.tcadYear } });
306: 		this.lastPropertyCount = this.stats.startingPropertyCount;
307: 		logger.info(`Starting: ${this.stats.startingPropertyCount.toLocaleString()}`);
308: 		logger.info(`Stop at: ${STOP_AT_PROPERTIES.toLocaleString()} or ${MAX_CONSECUTIVE_ZERO_BATCHES} consecutive zero-result batches`);
309: 		logger.info(`Remaining: ${(STOP_AT_PROPERTIES - this.stats.startingPropertyCount).toLocaleString()}\n`);
310: 		process.on("SIGINT", () => this.stop());
311: 		process.on("SIGTERM", () => this.stop());
312: 		this.startMonitoring();
313: 		while (this.running) {
314: 			const currentCount = await prisma.property.count({ where: { year: config.scraper.tcadYear } });
315: 			if (currentCount >= STOP_AT_PROPERTIES) {
316: 				logger.info(`STOP TARGET REACHED! Current count: ${currentCount.toLocaleString()}`);
317: 				break;
318: 			}
319: 			const newSinceLastCheck = currentCount - this.lastPropertyCount;
320: 			if (this.stats.batchesProcessed > 0 && newSinceLastCheck === 0) {
321: 				this.consecutiveZeroBatches++;
322: 				logger.warn(`Zero new properties (${this.consecutiveZeroBatches}/${MAX_CONSECUTIVE_ZERO_BATCHES} consecutive)`);
323: 				if (this.consecutiveZeroBatches >= MAX_CONSECUTIVE_ZERO_BATCHES) {
324: 					logger.info(`STOPPING: ${MAX_CONSECUTIVE_ZERO_BATCHES} consecutive batches with zero new properties`);
325: 					break;
326: 				}
327: 			} else if (newSinceLastCheck > 0) {
328: 				this.consecutiveZeroBatches = 0;
329: 			}
330: 			this.lastPropertyCount = currentCount;
331: 			const [waiting, active] = await Promise.all([
332: 				scraperQueue.getWaitingCount(),
333: 				scraperQueue.getActiveCount(),
334: 			]);
335: 			if (waiting + active < 100) {
336: 				await this.queueBatch();
337: 			} else {
338: 				logger.info(`Queue full (${waiting} waiting, ${active} active). Waiting...`);
339: 			}
340: 			await this.delay(DELAY_BETWEEN_BATCHES);
341: 		}
342: 		await this.printFinalReport();
343: 		process.exit(0);
344: 	}
345: 	private async queueBatch() {
346: 		const searchTerms = await this.termSelector.getNextBatch(BATCH_SIZE);
347: 		this.stats.batchesProcessed++;
348: 		logger.info(`Batch #${this.stats.batchesProcessed} (${searchTerms.length} terms)`);
349: 		for (const searchTerm of searchTerms) {
350: 			try {
351: 				await scraperQueue.add(
352: 					"scrape-properties",
353: 					{
354: 						searchTerm,
355: 						userId: "continuous-batch",
356: 						scheduled: true,
357: 					},
358: 					{
359: 						attempts: 3,
360: 						backoff: { type: "exponential", delay: 2000 },
361: 						removeOnComplete: 100,
362: 						removeOnFail: 50,
363: 					},
364: 				);
365: 				this.stats.totalQueued++;
366: 			} catch (error) {
367: 				logger.error(`Failed to queue ${searchTerm}: ${getErrorMessage(error)}`);
368: 			}
369: 		}
370: 		logger.info(`Queued ${searchTerms.length} jobs (Total: ${this.stats.totalQueued})`);
371: 	}
372: 	private startMonitoring() {
373: 		setInterval(async () => {
374: 			try {
375: 				const [currentCount, waiting, active, completed, failed] =
376: 					await Promise.all([
377: 						prisma.property.count({ where: { year: config.scraper.tcadYear } }),
378: 						scraperQueue.getWaitingCount(),
379: 						scraperQueue.getActiveCount(),
380: 						scraperQueue.getCompletedCount(),
381: 						scraperQueue.getFailedCount(),
382: 					]);
383: 				const newProperties = currentCount - this.stats.startingPropertyCount;
384: 				const progress = (currentCount / STOP_AT_PROPERTIES) * 100;
385: 				const elapsed = Math.floor((Date.now() - this.stats.startTime) / 1000);
386: 				const hours = Math.floor(elapsed / 3600);
387: 				const minutes = Math.floor((elapsed % 3600) / 60);
388: 				const rate = newProperties / (elapsed / 60);
389: 				logger.info(
390: 					`[${hours}h ${minutes}m] ${progress.toFixed(2)}% | ` +
391: 					`DB: ${currentCount.toLocaleString()} (+${newProperties.toLocaleString()}) | ` +
392: 					`Queue: ${waiting}w/${active}a/${completed}c/${failed}f | ` +
393: 					`${rate.toFixed(1)} props/min`,
394: 				);
395: 				if (rate > 0) {
396: 					const remaining = STOP_AT_PROPERTIES - currentCount;
397: 					const hoursRemaining = remaining / rate / 60;
398: 					logger.info(`ETA: ${hoursRemaining.toFixed(1)} hours`);
399: 				}
400: 			} catch (error) {
401: 				logger.error(`Monitoring error: ${getErrorMessage(error)}`);
402: 			}
403: 		}, CHECK_INTERVAL);
404: 	}
405: 	private async printFinalReport() {
406: 		const finalCount = await prisma.property.count({ where: { year: config.scraper.tcadYear } });
407: 		const elapsed = Math.floor((Date.now() - this.stats.startTime) / 1000);
408: 		const hours = Math.floor(elapsed / 3600);
409: 		const minutes = Math.floor((elapsed % 3600) / 60);
410: 		logger.info("\n=== FINAL REPORT ===");
411: 		logger.info(`Runtime: ${hours}h ${minutes}m`);
412: 		logger.info(`Starting: ${this.stats.startingPropertyCount.toLocaleString()}`);
413: 		logger.info(`Final: ${finalCount.toLocaleString()}`);
414: 		logger.info(`Added: ${(finalCount - this.stats.startingPropertyCount).toLocaleString()}`);
415: 		logger.info(`Jobs queued: ${this.stats.totalQueued.toLocaleString()}`);
416: 		logger.info(`Batches: ${this.stats.batchesProcessed}`);
417: 	}
418: 	private stop() {
419: 		logger.info("Stopping continuous scraper...");
420: 		this.running = false;
421: 	}
422: 	private delay(ms: number): Promise<void> {
423: 		return new Promise((resolve) => setTimeout(resolve, ms));
424: 	}
425: }
426: if (require.main === module) {
427: 	const scraper = new ContinuousBatchScraper();
428: 	scraper.run().catch((error) => {
429: 		logger.error(`Fatal error: ${getErrorMessage(error)}`);
430: 		process.exit(1);
431: 	});
432: }
</file>

