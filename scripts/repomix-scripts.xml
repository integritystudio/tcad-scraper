30: 	logger.info(
31: 		`   currentToken: ${refreshedToken ? `...${refreshedToken.slice(-4)}` : "null"}`,
32: 	);
33: 	const afterStats = tokenRefreshService.getStats();
34: 	logger.info(`   Stats: ${JSON.stringify(afterStats, null, 2)}`);
35: 	logger.info("\n5. Multiple getCurrentToken() calls:");
