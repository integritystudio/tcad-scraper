 43:   let enqueued = 0;
 44:   for (const searchTerm of ALL_TERMS) {
 45:     const job = await scraperQueue.add(
 46:       'scrape-properties',
 47:       { searchTerm, userId: '08-08-search', scheduled: true },
 48:       {
 49:         attempts: 3,
 50:         backoff: { type: 'exponential', delay: 2000 },
 51:         removeOnComplete: 200,
 52:         removeOnFail: 100,
 53:       },
 54:     );
 55:     jobMap.set(String(job.id), searchTerm);
 56:     enqueued++;
 57:     if (enqueued % 50 === 0) {
 58:       logger.info(`Enqueued ${enqueued}/${ALL_TERMS.length}...`);
 59:     }
 60:   }
 61:   logger.info(`Enqueued all ${enqueued} terms`);
 62:   return jobMap;
 63: }
 64: async function monitor(jobMap: Map<string, string>) {
 65:   const startCount = await prisma.property.count();
 66:   const startTime = Date.now();
 67:   const totalJobs = jobMap.size;
 68:   logger.info(`Starting property count: ${startCount.toLocaleString()}`);
 69:   logger.info(`Monitoring ${totalJobs} jobs (polling every ${POLL_INTERVAL_MS / 1000}s)...\n`);
 70:   let lastCompleted = 0;
 71:   let lastFailed = 0;
 72:   while (true) {
 73:     await new Promise(r => setTimeout(r, POLL_INTERVAL_MS));
 74:     const [waiting, active, completed, failed] = await Promise.all([
 75:       scraperQueue.getWaitingCount(),
 76:       scraperQueue.getActiveCount(),
 77:       scraperQueue.getCompletedCount(),
 78:       scraperQueue.getFailedCount(),
 79:     ]);
 80:     const currentCount = await prisma.property.count();
 81:     const newProps = currentCount - startCount;
 82:     const elapsed = Math.floor((Date.now() - startTime) / 1000);
 83:     const mins = Math.floor(elapsed / 60);
 84:     const secs = elapsed % 60;
 85:     const completedDelta = completed - lastCompleted;
 86:     const failedDelta = failed - lastFailed;
 87:     lastCompleted = completed;
 88:     lastFailed = failed;
 89:     logger.info(
 90:       `[${mins}m${secs.toString().padStart(2, '0')}s] ` +
 91:       `W:${waiting} A:${active} C:${completed}(+${completedDelta}) F:${failed}(+${failedDelta}) | ` +
 92:       `Props: ${currentCount.toLocaleString()} (+${newProps.toLocaleString()} new)`
 93:     );
 94:     if (waiting === 0 && active === 0) {
 95:       const finalCount = await prisma.property.count();
 96:       const totalNew = finalCount - startCount;
 97:       const totalElapsed = Math.floor((Date.now() - startTime) / 1000);
 98:       logger.info('\n=== 08-08-2026 Search Complete ===');
 99:       logger.info(`Runtime: ${Math.floor(totalElapsed / 60)}m ${totalElapsed % 60}s`);
100:       logger.info(`Terms: ${totalJobs} (${completed} completed, ${failed} failed)`);
101:       logger.info(`Properties: ${startCount.toLocaleString()} -> ${finalCount.toLocaleString()} (+${totalNew.toLocaleString()})`);
102:       logger.info(`Categories: ${NAMES.length} names, ${ENTITIES.length} entities, ${STREETS.length} streets, ${NUMBERS.length} numbers`);
103:       break;
104:     }
105:   }
106: }
107: async function run() {
108:   let running = true;
109:   process.on('SIGINT', () => { running = false; logger.info('Shutting down...'); });
110:   process.on('SIGTERM', () => { running = false; });
111:   try {
112:     logger.info('=== 08-08-2026 Search Term Enqueue ===');
113:     logger.info(`Terms: ${ALL_TERMS.length} (${NAMES.length} names, ${ENTITIES.length} entities, ${STREETS.length} streets, ${NUMBERS.length} numbers)`);
114:     const jobMap = await enqueueAll();
115:     if (running) await monitor(jobMap);
116:   } catch (error) {
117:     logger.error(`Fatal: ${getErrorMessage(error)}`);
118:     process.exit(1);
119:   } finally {
120:     await Promise.all([scraperQueue.close(), prisma.$disconnect()]);
121:   }
122: }
123: run();
</file>

<file path="enqueue-batch.ts">
 1: #!/usr/bin/env node
 2: import logger from "../lib/logger";
 3: import { BATCH_CONFIGS, getAvailableBatchTypes } from "./config/batch-configs";
 4: import { enqueueBatchGeneric } from "./utils/batch-enqueue";
 5: const args = process.argv.slice(2);
 6: if (args.length === 0 || args.includes("--help") || args.includes("-h")) {
 7: 	const types = getAvailableBatchTypes();
 8: 	console.log("Usage: npx tsx src/scripts/enqueue-batch.ts <batchType>");
 9: 	console.log("       npx tsx src/scripts/enqueue-batch.ts --all");
10: 	console.log("       npx tsx src/scripts/enqueue-batch.ts --list");
11: 	console.log(`\nAvailable batch types: ${types.join(", ")}`);
12: 	process.exit(0);
13: }
14: if (args.includes("--list")) {
15: 	const types = getAvailableBatchTypes();
16: 	for (const type of types) {
17: 		const cfg = BATCH_CONFIGS[type];
18: 		console.log(
19: 			`  ${type.padEnd(16)} ${cfg.emoji} ${cfg.batchName} (${cfg.terms.length} terms)`,
20: 		);
21: 	}
22: 	process.exit(0);
23: }
24: async function run() {
25: 	const batchTypes = args.includes("--all") ? getAvailableBatchTypes() : args;
26: 	for (const batchType of batchTypes) {
27: 		const config = BATCH_CONFIGS[batchType];
28: 		if (!config) {
29: 			logger.error(
30: 				`Unknown batch type: "${batchType}". Use --list to see available types.`,
31: 			);
32: 			process.exit(1);
33: 		}
34: 		await enqueueBatchGeneric(config);
35: 	}
36: }
37: run()
38: 	.then(() => process.exit(0))
39: 	.catch((error) => {
40: 		logger.error({ err: error }, "Script failed:");
41: 		process.exit(1);
42: 	});
