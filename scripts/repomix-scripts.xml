  1: #!/usr/bin/env node
  2: import { config } from "../../config";
  3: import logger from "../../lib/logger";
  4: import { scraperQueue } from "../../queues/scraper.queue";
  5: import { tokenRefreshService } from "../../services/token-refresh.service";
  6: const HIGH_VALUE_TERMS = [
  7: 	"Trust",
  8: 	"Trustee",
  9: 	"Estate",
 10: 	"Family Trust",
 11: 	"Revocable Trust",
 12: 	"Irrevocable Trust",
 13: 	"Living Trust",
 14: 	"Testamentary",
 15: 	"Fiduciary",
 16: 	"Beneficiary",
 17: 	"Investments",
 18: 	"Holdings",
 19: 	"Capital",
 20: 	"Fund",
 21: 	"Equity",
 22: 	"Ventures",
 23: 	"Asset",
 24: 	"Portfolio",
 25: 	"Management",
 26: 	"Partners",
 27: 	"LLC",
 28: 	"Limited",
 29: 	"Corporation",
 30: 	"Corp",
 31: 	"Inc",
 32: 	"Partnership",
 33: 	"LP",
 34: 	"LLP",
 35: 	"Company",
 36: 	"Group",
 37: 	"Commercial",
 38: 	"Residential",
 39: 	"Industrial",
 40: 	"Office",
 41: 	"Retail",
 42: 	"Warehouse",
 43: 	"Shopping",
 44: 	"Apartment",
 45: 	"Condo",
 46: 	"Development",
 47: ];
 48: async function enqueueHighValueBatch() {
 49: 	logger.info("💎 Starting High-Value Batch Enqueue (40 queries)");
 50: 	logger.info(`TCAD API token: ${config.scraper.tcadApiKey ? "configured" : "NOT configured"}`);
 51: 	try {
 52: 		logger.info("🔄 Step 1/2: Refreshing TCAD API token...");
 53: 		const startRefresh = Date.now();
 54: 		const token = await tokenRefreshService.refreshToken();
 55: 		const refreshDuration = Date.now() - startRefresh;
 56: 		if (token) {
 57: 			logger.info(`✅ Token refreshed successfully in ${refreshDuration}ms`);
 58: 			logger.info(`   Token preview: ...${token.slice(-4)}`);
 59: 		} else {
 60: 			logger.warn(
 61: 				"⚠️  Token refresh returned null - continuing with existing token",
 62: 			);
 63: 		}
 64: 		logger.info("\n📋 Step 2/2: Enqueueing high-value queries...");
 65: 		logger.info(`Total queries to enqueue: ${HIGH_VALUE_TERMS.length}`);
 66: 		let successCount = 0;
 67: 		let failCount = 0;
 68: 		const startEnqueue = Date.now();
 69: 		for (let i = 0; i < HIGH_VALUE_TERMS.length; i++) {
 70: 			const term = HIGH_VALUE_TERMS[i];
 71: 			try {
 72: 				let priority = 3;
 73: 				if (i < 10) {
 74: 					priority = 1;
 75: 				} else if (i < 20) {
 76: 					priority = 1;
 77: 				} else if (i < 30) {
 78: 					priority = 2;
 79: 				}
 80: 				const job = await scraperQueue.add(
 81: 					"scrape-properties",
 82: 					{
 83: 						searchTerm: term,
 84: 						userId: "high-value-batch-enqueue",
 85: 						scheduled: true,
 86: 					},
 87: 					{
 88: 						attempts: 3,
 89: 						backoff: {
 90: 							type: "exponential",
 91: 							delay: 2000,
 92: 						},
 93: 						priority,
 94: 						removeOnComplete: 100,
 95: 						removeOnFail: 50,
 96: 					},
 97: 				);
 98: 				successCount++;
 99: 				let category = "";
100: 				if (i < 10) category = "Trust/Estate";
101: 				else if (i < 20) category = "Investment";
102: 				else if (i < 30) category = "Corporate";
103: 				else category = "Commercial";
104: 				logger.info(
105: 					`✅ [${successCount}/${HIGH_VALUE_TERMS.length}] ` +
106: 						`Queued: "${term}" (${category}, Priority: ${priority}, Job ID: ${job.id})`,
107: 				);
108: 				if (i < HIGH_VALUE_TERMS.length - 1) {
109: 					await new Promise((resolve) => setTimeout(resolve, 100));
110: 				}
111: 			} catch (error) {
112: 				failCount++;
113: 				logger.error({ err: error }, `❌ Failed to queue "${term}"`);
114: 			}
115: 		}
116: 		const enqueueDuration = Date.now() - startEnqueue;
117: 		logger.info(`\n${"=".repeat(60)}`);
118: 		logger.info("📊 BATCH ENQUEUE SUMMARY");
119: 		logger.info("=".repeat(60));
120: 		logger.info(
121: 			`✅ Successfully queued: ${successCount}/${HIGH_VALUE_TERMS.length}`,
122: 		);
123: 		logger.info(`❌ Failed: ${failCount}`);
124: 		logger.info(`⏱️  Enqueue duration: ${enqueueDuration}ms`);
125: 		logger.info(
126: 			`⏱️  Total duration (with token refresh): ${refreshDuration + enqueueDuration}ms`,
127: 		);
128: 		if (successCount > 0) {
129: 			logger.info(`\n📈 Estimated minimum properties: ${successCount * 50}`);
130: 			logger.info(`📈 Estimated maximum properties: ${successCount * 100}`);
131: 			logger.info(`   (Trust/Estate terms typically yield 70-100+ each)`);
132: 		}
133: 		logger.info("\n✨ High-value batch enqueue completed!");
134: 		logger.info("Monitor progress at: http://localhost:3001/admin/queues");
135: 		logger.info("=".repeat(60));
136: 	} catch (error) {
137: 		logger.error({ err: error }, "❌ Fatal error");
138: 		process.exit(1);
139: 	}
140: }
141: enqueueHighValueBatch()
142: 	.then(() => process.exit(0))
143: 	.catch((error) => {
144: 		logger.error({ err: error }, "❌ Script failed");
145: 		process.exit(1);
146: 	});
