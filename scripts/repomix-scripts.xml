265: 			const batch = searchTerms.slice(i, i + this.config.batchSize);
266: 			const batchNum = Math.floor(i / this.config.batchSize) + 1;
267: 			const totalBatches = Math.ceil(
268: 				searchTerms.length / this.config.batchSize,
269: 			);
