172: async function main() {
173:   const validNames = new Set<string>();
174:   const dictProperCount = 0;
175:   const allLists = [
176:     FIRST_NAMES_FEMALE, FIRST_NAMES_MALE, LAST_NAMES,
177:     STREET_GEOGRAPHIC, BUSINESS_ENTITY,
178:   ];
179:   for (const list of allLists) {
180:     for (const name of list) {
181:       const lower = name.toLowerCase();
182:       if (lower.length === 5 && /^[a-z]{5}$/.test(lower)) {
183:         validNames.add(lower);
184:       }
185:     }
186:   }
187:   console.error(`Valid name set: ${validNames.size} entries (${dictProperCount} from dictionary proper nouns)`);
188:   const [analyticsRows, propTermRows] = await Promise.all([
189:     prisma.searchTermAnalytics.findMany({ select: { searchTerm: true } }),
190:     prisma.property.groupBy({
191:       by: ['searchTerm'],
192:       where: { year: 2025, searchTerm: { not: null } },
193:     }),
194:   ]);
195:   const searched = new Set<string>();
196:   for (const r of analyticsRows) searched.add(r.searchTerm.toLowerCase());
197:   for (const r of propTermRows) {
198:     if (r.searchTerm) searched.add(r.searchTerm.toLowerCase());
199:   }
200:   const blacklisted = await prisma.searchTermAnalytics.findMany({
201:     where: { successRate: 0, totalSearches: { gte: 3 } },
202:     select: { searchTerm: true },
203:   });
204:   const blacklistSet = new Set(blacklisted.map(b => b.searchTerm.toLowerCase()));
205:   console.error(`Already searched: ${searched.size} | Blacklisted: ${blacklistSet.size}`);
206:   const results = new Set<string>();
207:   const vowels = 'aeiou';
208:   const consonants = 'bcdfghjklmnpqrstvwxyz';
209:   let expansionHits = 0;
210:   for (const c1 of consonants) {
211:     for (const v1 of vowels) {
212:       for (const c2 of consonants) {
213:         for (const v2 of vowels) {
214:           const base = c1 + v1 + c2 + v2;
215:           for (let ch = 97; ch <= 122; ch++) {
216:             const candidate = base + String.fromCharCode(ch);
217:             if (!validNames.has(candidate)) continue;
218:             if (searched.has(candidate)) continue;
219:             if (blacklistSet.has(candidate)) continue;
220:             results.add(candidate);
221:             expansionHits++;
222:           }
223:         }
224:       }
225:     }
226:   }
227:   let directHits = 0;
228:   for (const name of validNames) {
229:     if (searched.has(name)) continue;
230:     if (blacklistSet.has(name)) continue;
231:     if (!results.has(name)) {
232:       results.add(name);
233:       directHits++;
234:     }
235:   }
236:   const sorted = [...results].sort().map(t => t.charAt(0).toUpperCase() + t.slice(1));
237:   console.error(`CVCV expansions that matched names: ${expansionHits}`);
238:   console.error(`Direct name inclusions: ${directHits}`);
239:   console.error(`Total unique terms: ${sorted.length}`);
240:   mkdirSync(join(__dirname, '..', '..', 'data'), { recursive: true });
241:   writeFileSync(OUTPUT_PATH, sorted.join('\n') + '\n');
242:   console.error(`Written to: ${OUTPUT_PATH}`);
243:   const firstF = new Set(FIRST_NAMES_FEMALE.map(n => n.toLowerCase()).filter(n => n.length === 5));
244:   const firstM = new Set(FIRST_NAMES_MALE.map(n => n.toLowerCase()).filter(n => n.length === 5));
245:   const lastN = new Set(LAST_NAMES.map(n => n.toLowerCase()).filter(n => n.length === 5));
246:   const geo = new Set(STREET_GEOGRAPHIC.map(n => n.toLowerCase()).filter(n => n.length === 5));
247:   const biz = new Set(BUSINESS_ENTITY.map(n => n.toLowerCase()).filter(n => n.length === 5));
248:   let catFirst = 0, catLast = 0, catGeo = 0, catBiz = 0, catDict = 0;
249:   for (const term of results) {
250:     if (firstF.has(term) || firstM.has(term)) catFirst++;
251:     else if (lastN.has(term)) catLast++;
252:     else if (geo.has(term)) catGeo++;
253:     else if (biz.has(term)) catBiz++;
254:     else catDict++;
255:   }
256:   console.error(`\nBy category:`);
257:   console.error(`  First names: ${catFirst}`);
258:   console.error(`  Last names: ${catLast}`);
259:   console.error(`  Geographic/street: ${catGeo}`);
260:   console.error(`  Business/entity: ${catBiz}`);
261:   console.error(`  Dictionary proper nouns: ${catDict}`);
262:   console.error(`\nPreview (first 50):`);
263:   for (const t of sorted.slice(0, 50)) {
264:     console.error(`  ${t}`);
265:   }
266:   await prisma.$disconnect();
267: }
268: main();
