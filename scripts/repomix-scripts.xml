11:   "Daigle", "Dewitt", "Dupree", "Eggleston", "Elledge",
12:   "Ethridge", "Farnsworth", "Faust", "Forsyth", "Fulmer",
13:   "Gaston", "Grisham", "Grogan", "Llamas", "Lucero",
14:   "Noriega", "Palomino", "Roldan", "Ruelas", "Zaragoza",
15:   "Ashby", "Cantrell", "Carver", "Chadwick", "Coburn",
16:   "Cordell", "Corley", "Cromwell", "Crowder", "Dunbar",
17:   "Hamby", "Irving", "Cox", "Venture",
18:   "Wholesale", "Trucking", "Logistics", "Petroleum", "Mining",
