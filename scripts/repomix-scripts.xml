<file path="requeue/requeue-with-fresh-tokens.ts">
  1: #!/usr/bin/env npx tsx
  2: import logger from "../../lib/logger";
  3: import { prisma } from "../../lib/prisma";
  4: import { scraperQueue } from "../../queues/scraper.queue";
  5: import { tokenRefreshService } from "../../services/token-refresh.service";
  6: import { getErrorMessage } from "../../utils/error-helpers";
  7: const THREE_MINUTES_MS = 3 * 60 * 1000;
  8: async function main() {
  9: 	logger.info("🔄 Re-queue Script with Fresh Token Refresh");
 10: 	logger.info("=".repeat(60));
 11: 	try {
 12: 		logger.info("\n📊 Step 1: Checking current queue status...");
 13: 		const [waiting, active, delayed, failedCount, completed] =
 14: 			await Promise.all([
 15: 				scraperQueue.getWaitingCount(),
 16: 				scraperQueue.getActiveCount(),
 17: 				scraperQueue.getDelayedCount(),
 18: 				scraperQueue.getFailedCount(),
 19: 				scraperQueue.getCompletedCount(),
 20: 			]);
 21: 		logger.info(`   - Waiting: ${waiting}`);
 22: 		logger.info(`   - Active: ${active}`);
 23: 		logger.info(`   - Delayed: ${delayed}`);
 24: 		logger.info(`   - Failed in queue: ${failedCount}`);
 25: 		logger.info(`   - Completed: ${completed}`);
 26: 		logger.info("\n📋 Step 2: Collecting jobs to re-queue...");
 27: 		const waitingJobs = await scraperQueue.getWaiting();
 28: 		const delayedJobs = await scraperQueue.getDelayed();
 29: 		const failedJobs = await scraperQueue.getFailed();
 30: 		const pendingTerms = new Set<string>();
 31: 		[...waitingJobs, ...delayedJobs].forEach((job) => {
 32: 			if (job.data.searchTerm) {
 33: 				pendingTerms.add(job.data.searchTerm);
 34: 			}
 35: 		});
 36: 		const dbFailedJobs = await prisma.scrapeJob.findMany({
 37: 			where: {
 38: 				status: "failed",
 39: 				error: {
 40: 					contains: "HTTP 401",
 41: 				},
 42: 			},
 43: 			select: { searchTerm: true },
 44: 			distinct: ["searchTerm"],
 45: 			orderBy: { startedAt: "desc" },
 46: 			take: 500,
 47: 		});
 48: 		const failedTerms = new Set<string>();
 49: 		dbFailedJobs.forEach((job) => {
 50: 			failedTerms.add(job.searchTerm);
 51: 		});
 52: 		failedJobs.forEach((job) => {
 53: 			if (job.data.searchTerm) {
 54: 				failedTerms.add(job.data.searchTerm);
 55: 			}
 56: 		});
 57: 		const allTerms = Array.from(new Set([...pendingTerms, ...failedTerms]));
 58: 		logger.info(`   - Pending terms from queue: ${pendingTerms.size}`);
 59: 		logger.info(`   - Failed terms (401 errors): ${failedTerms.size}`);
 60: 		logger.info(`   - Total unique terms to re-queue: ${allTerms.length}`);
 61: 		if (allTerms.length === 0) {
 62: 			logger.info("\n✅ No jobs to re-queue!");
 63: 			await cleanup();
 64: 			return;
 65: 		}
 66: 		logger.info("\n🛑 Step 3: Stopping and clearing pending jobs...");
 67: 		let removed = 0;
 68: 		for (const job of waitingJobs) {
 69: 			try {
 70: 				await job.remove();
 71: 				removed++;
