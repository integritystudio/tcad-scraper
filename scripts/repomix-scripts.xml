 21: 	}>;
 22: }
 23: async function analyzeFailedJobs(): Promise<FailureAnalysis> {
 24: 	logger.info("Analyzing failed scrape jobs...");
 25: 	const [totalJobs, failedJobs, completedJobs] = await Promise.all([
 26: 		prisma.scrapeJob.count(),
 27: 		prisma.scrapeJob.count({ where: { status: "failed" } }),
 28: 		prisma.scrapeJob.count({ where: { status: "completed" } }),
 29: 	]);
 30: 	const failureRate = totalJobs > 0 ? (failedJobs / totalJobs) * 100 : 0;
 31: 	logger.info(`Total jobs: ${totalJobs}`);
 32: 	logger.info(`Failed jobs: ${failedJobs} (${failureRate.toFixed(2)}%)`);
 33: 	logger.info(`Completed jobs: ${completedJobs}`);
 34: 	const failedJobsData = await prisma.scrapeJob.findMany({
 35: 		where: { status: "failed" },
 36: 		select: {
 37: 			searchTerm: true,
 38: 			error: true,
 39: 			completedAt: true,
 40: 		},
 41: 		orderBy: { completedAt: "desc" },
 42: 	});
 43: 	const errorGroups = new Map<
 44: 		string,
 45: 		{ count: number; searchTerms: Set<string> }
 46: 	>();
 47: 	for (const job of failedJobsData) {
 48: 		const errorMsg = job.error || "Unknown error";
 49: 		if (!errorGroups.has(errorMsg)) {
 50: 			errorGroups.set(errorMsg, { count: 0, searchTerms: new Set() });
 51: 		}
 52: 		const group = errorGroups.get(errorMsg)!;
 53: 		group.count++;
 54: 		group.searchTerms.add(job.searchTerm);
 55: 	}
 56: 	const errorBreakdown: ErrorStats[] = Array.from(errorGroups.entries())
 57: 		.map(([errorMessage, data]) => ({
 58: 			errorMessage,
 59: 			count: data.count,
 60: 			percentage: failedJobs > 0 ? (data.count / failedJobs) * 100 : 0,
 61: 			searchTerms: Array.from(data.searchTerms).slice(0, 5),
 62: 		}))
 63: 		.sort((a, b) => b.count - a.count);
 64: 	const recentFailures = failedJobsData.slice(0, 20).map((job) => ({
 65: 		searchTerm: job.searchTerm,
 66: 		error: job.error,
 67: 		completedAt: job.completedAt,
 68: 	}));
 69: 	return {
 70: 		totalJobs,
 71: 		failedJobs,
 72: 		completedJobs,
 73: 		failureRate,
 74: 		errorBreakdown,
 75: 		recentFailures,
 76: 	};
 77: }
 78: async function main() {
 79: 	try {
 80: 		const analysis = await analyzeFailedJobs();
 81: 		logger.info("========================================");
 82: 		logger.info("FAILED JOBS ANALYSIS");
 83: 		logger.info("========================================");
 84: 		logger.info(`Total Jobs: ${analysis.totalJobs}`);
 85: 		logger.info(
 86: 			`Failed: ${analysis.failedJobs} (${analysis.failureRate.toFixed(2)}%)`,
 87: 		);
 88: 		logger.info(`Completed: ${analysis.completedJobs}`);
 89: 		logger.info("========================================");
 90: 		logger.info("ERROR BREAKDOWN (by frequency)");
 91: 		logger.info("========================================");
 92: 		for (const [index, error] of analysis.errorBreakdown.entries()) {
 93: 			logger.info(`${index + 1}. ${error.errorMessage}`);
 94: 			logger.info(
 95: 				`   Count: ${error.count} (${error.percentage.toFixed(2)}% of failures)`,
 96: 			);
 97: 			logger.info(`   Sample search terms: ${error.searchTerms.join(", ")}`);
 98: 		}
 99: 		logger.info("========================================");
100: 		logger.info("RECENT FAILURES (last 20)");
101: 		logger.info("========================================");
102: 		for (const failure of analysis.recentFailures) {
103: 			const timestamp = failure.completedAt
104: 				? failure.completedAt.toISOString()
105: 				: "N/A";
106: 			logger.info(`[${timestamp}] "${failure.searchTerm}"`);
107: 			logger.info(`  Error: ${failure.error || "Unknown"}`);
108: 		}
109: 		logger.info("========================================");
110: 		logger.info("ERROR CATEGORIES");
111: 		logger.info("========================================");
112: 		const categories = {
113: 			tokenExpired: analysis.errorBreakdown.filter(
114: 				(e) =>
115: 					e.errorMessage.includes("TOKEN_EXPIRED") ||
116: 					e.errorMessage.includes("HTTP 401"),
117: 			),
118: 			timeout: analysis.errorBreakdown.filter(
119: 				(e) =>
120: 					e.errorMessage.includes("GATEWAY_TIMEOUT") ||
121: 					e.errorMessage.includes("HTTP 504") ||
122: 					e.errorMessage.includes("timeout"),
123: 			),
124: 			truncated: analysis.errorBreakdown.filter((e) =>
125: 				e.errorMessage.includes("TRUNCATED"),
126: 			),
127: 			captureFailure: analysis.errorBreakdown.filter((e) =>
128: 				e.errorMessage.includes("Failed to capture authorization token"),
129: 			),
130: 			other: analysis.errorBreakdown.filter(
131: 				(e) =>
132: 					!e.errorMessage.includes("TOKEN_EXPIRED") &&
133: 					!e.errorMessage.includes("HTTP 401") &&
134: 					!e.errorMessage.includes("GATEWAY_TIMEOUT") &&
135: 					!e.errorMessage.includes("HTTP 504") &&
136: 					!e.errorMessage.includes("timeout") &&
137: 					!e.errorMessage.includes("TRUNCATED") &&
138: 					!e.errorMessage.includes("Failed to capture authorization token"),
139: 			),
140: 		};
141: 		const categoryCounts = {
142: 			tokenExpired: categories.tokenExpired.reduce(
143: 				(sum, e) => sum + e.count,
144: 				0,
145: 			),
146: 			timeout: categories.timeout.reduce((sum, e) => sum + e.count, 0),
147: 			truncated: categories.truncated.reduce((sum, e) => sum + e.count, 0),
148: 			captureFailure: categories.captureFailure.reduce(
149: 				(sum, e) => sum + e.count,
150: 				0,
151: 			),
152: 			other: categories.other.reduce((sum, e) => sum + e.count, 0),
153: 		};
154: 		logger.info(
155: 			`Token Expired (HTTP 401): ${categoryCounts.tokenExpired} (${((categoryCounts.tokenExpired / analysis.failedJobs) * 100).toFixed(2)}%)`,
156: 		);
157: 		logger.info(
158: 			`Timeout Errors (HTTP 504): ${categoryCounts.timeout} (${((categoryCounts.timeout / analysis.failedJobs) * 100).toFixed(2)}%)`,
159: 		);
160: 		logger.info(
161: 			`Truncated Responses: ${categoryCounts.truncated} (${((categoryCounts.truncated / analysis.failedJobs) * 100).toFixed(2)}%)`,
162: 		);
163: 		logger.info(
164: 			`Token Capture Failures: ${categoryCounts.captureFailure} (${((categoryCounts.captureFailure / analysis.failedJobs) * 100).toFixed(2)}%)`,
165: 		);
166: 		logger.info(
167: 			`Other Errors: ${categoryCounts.other} (${((categoryCounts.other / analysis.failedJobs) * 100).toFixed(2)}%)`,
168: 		);
169: 	} finally {
170: 		await prisma.$disconnect();
171: 	}
172: }
173: main().catch((error: unknown) => {
174: 	logger.error(`Script failed: ${getErrorMessage(error)}`);
175: 	if (error instanceof Error && error.stack) {
176: 		logger.debug(error.stack);
177: 	}
178: 	process.exit(1);
179: });
</file>

<file path="analyze-search-terms.ts">
  1: #!/usr/bin/env npx tsx
  2: import { PrismaClient } from "@prisma/client";
  3: const prisma = new PrismaClient();
  4: async function analyzeSearchTerms(): Promise<void> {
  5: 	console.log("\n=== Search Term Analysis ===\n");
  6: 	const totalJobs = await prisma.scrapeJob.count();
  7: 	const completedJobs = await prisma.scrapeJob.count({
  8: 		where: { status: "completed" },
  9: 	});
 10: 	const failedJobs = await prisma.scrapeJob.count({
 11: 		where: { status: "failed" },
 12: 	});
 13: 	const pendingJobs = await prisma.scrapeJob.count({
 14: 		where: { status: "pending" },
 15: 	});
 16: 	console.log("📊 Overall Job Stats:");
 17: 	console.log(`   Total jobs: ${totalJobs}`);
 18: 	console.log(
 19: 		`   Completed: ${completedJobs} (${((completedJobs / totalJobs) * 100).toFixed(1)}%)`,
 20: 	);
 21: 	console.log(
 22: 		`   Failed: ${failedJobs} (${((failedJobs / totalJobs) * 100).toFixed(1)}%)`,
 23: 	);
 24: 	console.log(`   Pending: ${pendingJobs}`);
 25: 	const uniqueTermsResult = await prisma.$queryRaw<{ count: bigint }[]>`
 26:     SELECT COUNT(DISTINCT search_term) as count FROM scrape_jobs
 27:   `;
 28: 	const uniqueTerms = Number(uniqueTermsResult[0].count);
 29: 	console.log(`\n📝 Unique search terms used: ${uniqueTerms}`);
 30: 	console.log("\n✅ Top 20 Most Successful Search Terms:");
 31: 	const topTerms = await prisma.$queryRaw<
 32: 		{
 33: 			search_term: string;
 34: 			job_count: bigint;
 35: 			success_count: bigint;
 36: 			total_results: bigint;
 37: 			avg_results: number;
 38: 		}[]
 39: 	>`
 40:     SELECT
 41:       search_term,
 42:       COUNT(*) as job_count,
 43:       SUM(CASE WHEN status = 'completed' THEN 1 ELSE 0 END) as success_count,
 44:       SUM(COALESCE(result_count, 0)) as total_results,
 45:       AVG(CASE WHEN status = 'completed' THEN result_count ELSE NULL END) as avg_results
 46:     FROM scrape_jobs
 47:     WHERE search_term IS NOT NULL
 48:     GROUP BY search_term
 49:     HAVING SUM(CASE WHEN status = 'completed' THEN 1 ELSE 0 END) > 0
 50:     ORDER BY total_results DESC
 51:     LIMIT 20
 52:   `;
 53: 	topTerms.forEach((term, i) => {
 54: 		const successRate =
 55: 			(Number(term.success_count) / Number(term.job_count)) * 100;
 56: 		console.log(
 57: 			`   ${i + 1}. "${term.search_term}": ${Number(term.total_results).toLocaleString()} props ` +
 58: 				`(${Number(term.job_count)} jobs, ${successRate.toFixed(0)}% success, avg ${Math.round(term.avg_results || 0)}/job)`,
 59: 		);
 60: 	});
 61: 	console.log("\n❌ Search Terms That Always Fail (top 20):");
 62: 	const failingTerms = await prisma.$queryRaw<
 63: 		{
 64: 			search_term: string;
 65: 			fail_count: bigint;
 66: 			last_error: string | null;
 67: 		}[]
 68: 	>`
 69:     SELECT
 70:       search_term,
 71:       COUNT(*) as fail_count,
 72:       MAX(error) as last_error
 73:     FROM scrape_jobs
 74:     WHERE status = 'failed' AND search_term IS NOT NULL
 75:     GROUP BY search_term
 76:     HAVING SUM(CASE WHEN status = 'completed' THEN 1 ELSE 0 END) = 0
 77:     ORDER BY fail_count DESC
 78:     LIMIT 20
 79:   `;
 80: 	failingTerms.forEach((term, i) => {
 81: 		const errorPreview = term.last_error
 82: 			? term.last_error.substring(0, 50)
 83: 			: "Unknown";
 84: 		console.log(
 85: 			`   ${i + 1}. "${term.search_term}": ${Number(term.fail_count)} failures - ${errorPreview}...`,
 86: 		);
 87: 	});
 88: 	console.log("\n🔄 Recently Successful Terms (last 30 days):");
 89: 	const recentTerms = await prisma.$queryRaw<
 90: 		{
 91: 			search_term: string;
 92: 			result_count: number;
 93: 			completed_at: Date;
 94: 		}[]
 95: 	>`
 96:     SELECT search_term, result_count, completed_at
 97:     FROM scrape_jobs
 98:     WHERE status = 'completed'
 99:       AND completed_at > NOW() - INTERVAL '30 days'
100:       AND result_count > 0
101:     ORDER BY completed_at DESC
102:     LIMIT 10
103:   `;
104: 	if (recentTerms.length === 0) {
105: 		console.log("   ⚠️ No successful jobs in last 30 days!");
106: 	} else {
107: 		recentTerms.forEach((term, i) => {
108: 			console.log(
109: 				`   ${i + 1}. "${term.search_term}": ${term.result_count} props (${term.completed_at.toLocaleDateString()})`,
110: 			);
111: 		});
112: 	}
113: 	console.log("\n📂 Search Term Categories:");
114: 	const categories = {
115: 		"Entity (LLC, Inc, Corp, Trust)": await countTermsMatching([
116: 			"LLC",
117: 			"Inc",
118: 			"Corp",
119: 			"Trust",
120: 			"LTD",
121: 		]),
122: 		"First Names (common)": await countTermsMatching([
123: 			"James",
124: 			"John",
125: 			"Mary",
126: 			"Robert",
127: 			"Michael",
128: 		]),
129: 		"Last Names (common)": await countTermsMatching([
130: 			"Smith",
131: 			"Johnson",
132: 			"Williams",
133: 			"Brown",
134: 			"Jones",
135: 		]),
136: 		Streets: await countTermsMatching([
137: 			"Lamar",
138: 			"Congress",
139: 			"Guadalupe",
140: 			"Burnet",
141: 			"Airport",
142: 		]),
143: 		Neighborhoods: await countTermsMatching([
144: 			"Hyde",
145: 			"Park",
146: 			"Zilker",
147: 			"Mueller",
148: 			"Barton",
149: 		]),
150: 	};
151: 	for (const [category, count] of Object.entries(categories)) {
152: 		console.log(`   ${category}: ${count} unique terms used`);
153: 	}
154: 	console.log("\n📊 Property Coverage:");
155: 	const propertyCount = await prisma.property.count();
156: 	console.log(`   Total properties in DB: ${propertyCount.toLocaleString()}`);
157: 	console.log(`   Target (TCAD total): 451,339`);
158: 	console.log(`   Coverage: ${((propertyCount / 451339) * 100).toFixed(1)}%`);
159: 	console.log(`   Remaining: ${(451339 - propertyCount).toLocaleString()}`);
160: 	console.log("\n💡 Recommendations:");
161: 	if (failedJobs / totalJobs > 0.3) {
162: 		console.log("   ⚠️ High failure rate (>30%) - check TCAD API/token issues");
163: 	}
164: 	if (recentTerms.length === 0) {
165: 		console.log(
166: 			"   ⚠️ No recent successful scrapes - restart continuous scraper",
167: 		);
168: 	}
169: 	if (uniqueTerms < 1000) {
170: 		console.log("   📝 Consider adding more search terms to pattern generator");
171: 	}
172: 	if (propertyCount / 451339 > 0.9) {
173: 		console.log(
174: 			"   ✅ High coverage achieved - focus on entity/trust searches for remaining properties",
175: 		);
176: 	}
177: 	await prisma.$disconnect();
178: }
179: async function countTermsMatching(patterns: string[]): Promise<number> {
180: 	const conditions = patterns
181: 		.map((p) => `search_term ILIKE '%${p}%'`)
182: 		.join(" OR ");
183: 	const result = await prisma.$queryRawUnsafe<{ count: bigint }[]>(`
184:     SELECT COUNT(DISTINCT search_term) as count
185:     FROM scrape_jobs
186:     WHERE ${conditions}
187:   `);
188: 	return Number(result[0].count);
189: }
190: analyzeSearchTerms()
191: 	.catch(console.error)
192: 	.finally(() => process.exit(0));
</file>

<file path="auto-requeue-on-401.ts">
  1: #!/usr/bin/env npx tsx
  2: import logger from "../lib/logger";
  3: import { prisma } from "../lib/prisma";
  4: import { scraperQueue } from "../queues/scraper.queue";
  5: import { tokenRefreshService } from "../services/token-refresh.service";
  6: import { getErrorMessage } from "../utils/error-helpers";
  7: const BATCH_SIZE = 50;
  8: const CHECK_INTERVAL_MS = 60000;
  9: const TOKEN_REFRESH_INTERVAL_MS = 3 * 60 * 1000;
 10: let lastCheck = new Date();
 11: let isProcessing = false;
 12: let consecutiveErrorCount = 0;
 13: async function check401Errors() {
 14: 	if (isProcessing) {
 15: 		logger.info("Already processing 401 errors, skipping this check...");
 16: 		return;
 17: 	}
 18: 	try {
 19: 		isProcessing = true;
 20: 		const recentErrors = await prisma.scrapeJob.count({
 21: 			where: {
 22: 				status: "failed",
 23: 				error: {
 24: 					contains: "HTTP 401",
 25: 				},
 26: 				startedAt: {
 27: 					gte: lastCheck,
 28: 				},
 29: 			},
 30: 		});
 31: 		if (recentErrors > 0) {
 32: 			logger.warn(
 33: 				`⚠️  Detected ${recentErrors} new 401 errors since last check!`,
 34: 			);
 35: 			consecutiveErrorCount++;
 36: 			logger.info("🔑 Refreshing API token due to 401 errors...");
 37: 			const newToken = await tokenRefreshService.refreshToken();
 38: 			if (!newToken) {
 39: 				logger.error("❌ Failed to refresh token!");
 40: 				return;
 41: 			}
 42: 			logger.info(
 43: 				`✅ Token refreshed successfully (length: ${newToken.length})`,
 44: 			);
 45: 			const failedJobs = await prisma.scrapeJob.findMany({
 46: 				where: {
 47: 					status: "failed",
 48: 					error: {
 49: 						contains: "HTTP 401",
 50: 					},
 51: 				},
 52: 				select: { searchTerm: true },
 53: 				distinct: ["searchTerm"],
 54: 				orderBy: { startedAt: "desc" },
 55: 			});
 56: 			const termsToRequeue = Array.from(
 57: 				new Set(failedJobs.map((j) => j.searchTerm)),
 58: 			);
 59: 			logger.info(
 60: 				`📋 Found ${termsToRequeue.length} unique terms with 401 errors`,
 61: 			);
 62: 			const cleanedCount = await scraperQueue.clean(0, "failed");
 63: 			logger.info(`🧹 Cleaned ${cleanedCount.length} failed jobs from queue`);
 64: 			logger.info(
 65: 				`🚀 Re-enqueueing ${termsToRequeue.length} jobs in batches of ${BATCH_SIZE}...`,
 66: 			);
 67: 			for (let i = 0; i < termsToRequeue.length; i += BATCH_SIZE) {
 68: 				const batch = termsToRequeue.slice(i, i + BATCH_SIZE);
 69: 				const batchNum = Math.floor(i / BATCH_SIZE) + 1;
 70: 				const totalBatches = Math.ceil(termsToRequeue.length / BATCH_SIZE);
 71: 				logger.info(
 72: 					`   Batch ${batchNum}/${totalBatches}: Enqueueing ${batch.length} jobs...`,
 73: 				);
 74: 				for (const term of batch) {
 75: 					try {
 76: 						await scraperQueue.add(
 77: 							"scrape-properties",
 78: 							{
 79: 								searchTerm: term,
 80: 								userId: "auto-requeue-401",
 81: 								scheduled: false,
 82: 							},
 83: 							{
 84: 								priority: 3,
 85: 								attempts: 3,
 86: 								backoff: {
 87: 									type: "exponential",
 88: 									delay: 2000,
 89: 								},
 90: 								removeOnComplete: false,
 91: 								removeOnFail: false,
 92: 							},
 93: 						);
 94: 					} catch (error: unknown) {
 95: 						logger.error(
 96: 							`   ❌ Failed to enqueue "${term}": ${getErrorMessage(error)}`,
 97: 						);
 98: 					}
 99: 				}
100: 				logger.info(`   ✅ Batch ${batchNum}/${totalBatches} enqueued`);
101: 				if (i + BATCH_SIZE < termsToRequeue.length) {
102: 					await new Promise((resolve) => setTimeout(resolve, 1000));
103: 				}
104: 			}
105: 			logger.info(
106: 				`✅ Re-enqueued all ${termsToRequeue.length} jobs successfully`,
107: 			);
108: 			consecutiveErrorCount = 0;
109: 		} else {
110: 			logger.info(
111: 				`✅ No new 401 errors detected (checked ${recentErrors} jobs)`,
112: 			);
113: 			consecutiveErrorCount = 0;
114: 		}
115: 		lastCheck = new Date();
116: 	} catch (error) {
117: 		logger.error(error as Error, "❌ Error checking for 401 errors");
118: 		consecutiveErrorCount++;
119: 		if (consecutiveErrorCount >= 3) {
120: 			logger.warn("⚠️  Too many consecutive errors, forcing token refresh...");
121: 			await tokenRefreshService.refreshToken();
122: 			consecutiveErrorCount = 0;
123: 		}
124: 	} finally {
125: 		isProcessing = false;
126: 	}
127: }
128: async function showStatus() {
129: 	const [waiting, active, delayed, failed, completed] = await Promise.all([
130: 		scraperQueue.getWaitingCount(),
131: 		scraperQueue.getActiveCount(),
132: 		scraperQueue.getDelayedCount(),
133: 		scraperQueue.getFailedCount(),
134: 		scraperQueue.getCompletedCount(),
135: 	]);
136: 	const tokenStats = tokenRefreshService.getStats();
137: 	logger.info("\n📊 Status Update:");
138: 	logger.info("   Queue:");
139: 	logger.info(`     - Waiting: ${waiting}`);
140: 	logger.info(`     - Active: ${active}`);
141: 	logger.info(`     - Delayed: ${delayed}`);
142: 	logger.info(`     - Failed: ${failed}`);
143: 	logger.info(`     - Completed: ${completed}`);
144: 	logger.info("   Token:");
145: 	logger.info(`     - Last refresh: ${tokenStats.lastRefreshTime}`);
146: 	logger.info(`     - Success count: ${tokenStats.successCount}`);
147: 	logger.info(`     - Failure count: ${tokenStats.failureCount}`);
148: }
149: async function main() {
150: 	logger.info("🤖 Auto-Requeue on 401 Handler Starting");
151: 	logger.info("=".repeat(60));
152: 	logger.info(`   Check interval: ${CHECK_INTERVAL_MS / 1000}s`);
153: 	logger.info(
154: 		`   Token refresh interval: ${TOKEN_REFRESH_INTERVAL_MS / 1000}s`,
155: 	);
156: 	logger.info(`   Batch size: ${BATCH_SIZE} jobs`);
157: 	logger.info("=".repeat(60));
158: 	logger.info("\n🔑 Performing initial token refresh...");
159: 	const initialToken = await tokenRefreshService.refreshToken();
160: 	if (!initialToken) {
161: 		logger.error("❌ Failed to get initial token!");
162: 		process.exit(1);
163: 	}
164: 	logger.info("✅ Initial token acquired");
165: 	logger.info("\n⏰ Starting automatic token refresh (every 3 minutes)...");
166: 	tokenRefreshService.startAutoRefreshInterval(TOKEN_REFRESH_INTERVAL_MS);
167: 	logger.info("✅ Auto-refresh started");
168: 	await showStatus();
169: 	logger.info("\n👀 Starting 401 error monitoring loop...");
170: 	logger.info("   Press Ctrl+C to stop\n");
171: 	await check401Errors();
172: 	const checkInterval = setInterval(async () => {
173: 		logger.info("\n🔍 Running periodic 401 error check...");
174: 		await check401Errors();
175: 		await showStatus();
176: 	}, CHECK_INTERVAL_MS);
177: 	process.on("SIGINT", async () => {
178: 		logger.info("\n\n👋 Shutting down...");
179: 		clearInterval(checkInterval);
180: 		await cleanup();
181: 		process.exit(0);
182: 	});
183: 	process.on("SIGTERM", async () => {
184: 		logger.info("\n\n👋 Shutting down...");
185: 		clearInterval(checkInterval);
186: 		await cleanup();
