 53:   console.log(`  Already-searched terms: ${searched.size}`);
 54:   const candidates: CandidateTerm[] = [];
 55:   console.log("  Mining owner first-words from 2026-only properties...");
 56:   const firstWords = await prisma.$queryRaw<Array<{ word: string; cnt: number }>>`
 57:     SELECT SPLIT_PART(p.name, ' ', 1) as word, COUNT(DISTINCT p.property_id)::int as cnt
 58:     FROM properties p
 59:     WHERE p.year = 2026
 60:     AND p.property_id NOT IN (SELECT property_id FROM properties WHERE year = 2025)
 61:     AND LENGTH(SPLIT_PART(p.name, ' ', 1)) >= ${MIN_TERM_LENGTH}
 62:     AND SPLIT_PART(p.name, ' ', 1) ~ '^[A-Za-z]'
 63:     GROUP BY SPLIT_PART(p.name, ' ', 1)
 64:     HAVING COUNT(DISTINCT p.property_id) >= ${MIN_PROPS_PER_TERM}
 65:     ORDER BY cnt DESC`;
 66:   for (const w of firstWords) candidates.push({ term: w.word, yield: w.cnt, source: "owner" });
 67:   console.log(`    First-words mined: ${firstWords.length}`);
 68:   console.log("  Mining street names from 2026-only properties...");
 69:   const streets = await prisma.$queryRaw<Array<{ street: string; cnt: number }>>`
 70:     SELECT SPLIT_PART(property_address, ' ', 2) as street,
 71:            COUNT(DISTINCT property_id)::int as cnt
 72:     FROM properties
 73:     WHERE year = 2026
 74:     AND property_id NOT IN (SELECT property_id FROM properties WHERE year = 2025)
 75:     AND property_address IS NOT NULL
 76:     AND LENGTH(SPLIT_PART(property_address, ' ', 2)) >= ${MIN_TERM_LENGTH}
 77:     AND SPLIT_PART(property_address, ' ', 2) ~ '^[A-Za-z]'
 78:     GROUP BY SPLIT_PART(property_address, ' ', 2)
 79:     HAVING COUNT(DISTINCT property_id) >= ${MIN_PROPS_PER_TERM}
 80:     ORDER BY cnt DESC`;
 81:   for (const s of streets) candidates.push({ term: s.street, yield: s.cnt, source: "street" });
 82:   console.log(`    Street names mined: ${streets.length}`);
 83:   console.log("  Mining description keywords...");
 84:   const descs = await prisma.$queryRaw<Array<{ word: string; cnt: number }>>`
 85:     SELECT SPLIT_PART(p.description, ' ', 1) as word, COUNT(DISTINCT p.property_id)::int as cnt
 86:     FROM properties p
 87:     WHERE p.year = 2026
 88:     AND p.property_id NOT IN (SELECT property_id FROM properties WHERE year = 2025)
 89:     AND p.description IS NOT NULL
 90:     AND LENGTH(SPLIT_PART(p.description, ' ', 1)) >= ${MIN_TERM_LENGTH}
 91:     AND SPLIT_PART(p.description, ' ', 1) ~ '^[A-Za-z]'
 92:     GROUP BY SPLIT_PART(p.description, ' ', 1)
 93:     HAVING COUNT(DISTINCT p.property_id) >= ${MIN_PROPS_PER_TERM}
 94:     ORDER BY cnt DESC`;
