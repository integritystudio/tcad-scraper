 10: const MIN_PROPS_PER_TERM = 10;
 11: async function get2025Count(): Promise<number> {
 12:   const result = await prisma.$queryRaw<[{ count: number }]>`
 13:     SELECT COUNT(*)::int as count FROM properties WHERE year = 2025`;
 14:   return result[0].count;
 15: }
 16: async function getSearchedTerms(): Promise<Set<string>> {
 17:   const [terms25, terms26, jobs] = await Promise.all([
 18:     prisma.$queryRaw<Array<{ search_term: string }>>`
 19:       SELECT DISTINCT search_term FROM properties WHERE year = 2025`,
 20:     prisma.$queryRaw<Array<{ search_term: string }>>`
 21:       SELECT DISTINCT search_term FROM properties WHERE year = 2026`,
 22:     prisma.scrapeJob.findMany({
 23:       where: { startedAt: { gte: new Date(Date.now() - RECENT_JOBS_LOOKBACK_MS) } },
 24:       select: { searchTerm: true },
 25:     }),
 26:   ]);
 27:   const searched = new Set<string>();
 28:   for (const r of terms25) searched.add(r.search_term.toLowerCase());
 29:   for (const r of terms26) searched.add(r.search_term.toLowerCase());
 30:   for (const j of jobs) searched.add(j.searchTerm.toLowerCase());
 31:   const analytics = await prisma.searchTermAnalytics.findMany({
 32:     select: { searchTerm: true },
 33:   });
 34:   for (const a of analytics) searched.add(a.searchTerm.toLowerCase());
 35:   return searched;
 36: }
 37: function buildPrefixIndex(searched: Set<string>): Set<string> {
 38:   const prefixes = new Set<string>();
 39:   for (const term of searched) {
 40:     for (let len = MIN_TERM_LENGTH; len < term.length; len++) {
 41:       prefixes.add(term.substring(0, len));
 42:     }
 43:   }
 44:   return prefixes;
 45: }
