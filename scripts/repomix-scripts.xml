 1: import { describe, expect, it } from "vitest";
 2: import { BATCH_CONFIGS, getAvailableBatchTypes } from "../batch-configs";
 3: describe("batch-configs", () => {
 4: 	it("should have no duplicate terms across batches", () => {
 5: 		const seen = new Map<string, string>();
 6: 		const duplicates: string[] = [];
 7: 		for (const [batchType, config] of Object.entries(BATCH_CONFIGS)) {
 8: 			for (const term of config.terms) {
 9: 				const existing = seen.get(term);
10: 				if (existing) {
11: 					duplicates.push(`"${term}" in both "${existing}" and "${batchType}"`);
12: 				} else {
13: 					seen.set(term, batchType);
14: 				}
15: 			}
16: 		}
17: 		expect(
18: 			duplicates,
19: 			`Duplicate terms found:\n${duplicates.join("\n")}`,
20: 		).toHaveLength(0);
21: 	});
22: 	it("should have no duplicate terms within a single batch", () => {
23: 		const duplicates: string[] = [];
24: 		for (const [batchType, config] of Object.entries(BATCH_CONFIGS)) {
25: 			const seen = new Set<string>();
26: 			for (const term of config.terms) {
27: 				if (seen.has(term)) {
28: 					duplicates.push(`"${term}" duplicated in "${batchType}"`);
29: 				}
30: 				seen.add(term);
31: 			}
32: 		}
33: 		expect(
34: 			duplicates,
35: 			`Intra-batch duplicates:\n${duplicates.join("\n")}`,
36: 		).toHaveLength(0);
37: 	});
38: 	it("should have no empty terms", () => {
39: 		for (const [batchType, config] of Object.entries(BATCH_CONFIGS)) {
40: 			for (const term of config.terms) {
41: 				expect(term.trim(), `Empty term in "${batchType}"`).not.toBe("");
42: 			}
43: 		}
44: 	});
45: 	it("should have no terms with leading or trailing whitespace", () => {
46: 		const violations: string[] = [];
47: 		for (const [batchType, config] of Object.entries(BATCH_CONFIGS)) {
48: 			for (const term of config.terms) {
49: 				if (term !== term.trim()) {
50: 					violations.push(`"${term}" has whitespace in "${batchType}"`);
51: 				}
52: 			}
53: 		}
54: 		expect(
55: 			violations,
56: 			`Whitespace violations:\n${violations.join("\n")}`,
57: 		).toHaveLength(0);
58: 	});
59: 	it("should have at least one term per batch", () => {
60: 		const empty: string[] = [];
61: 		for (const [batchType, config] of Object.entries(BATCH_CONFIGS)) {
62: 			if (config.terms.length === 0) {
63: 				empty.push(batchType);
64: 			}
65: 		}
66: 		expect(empty, `Batches with no terms: ${empty.join(", ")}`).toHaveLength(0);
67: 	});
68: 	it("should return all batch types from getAvailableBatchTypes", () => {
69: 		const types = getAvailableBatchTypes();
70: 		expect(types).toEqual(Object.keys(BATCH_CONFIGS));
71: 		expect(types.length).toBeGreaterThan(0);
72: 	});
73: });
