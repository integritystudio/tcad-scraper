58: 		logger.info(`\n📊 Summary: ${successCount} queued, ${failCount} failed`);
59: 		logger.info(`✨ ${batchName} batch enqueue completed!`);
60: 		return {
61: 			successCount,
62: 			failCount,
63: 			totalTerms: terms.length,
64: 		};
65: 	} catch (error) {
66: 		logger.error({ err: error }, "❌ Fatal error:");
67: 		throw error;
68: 	}
69: }
