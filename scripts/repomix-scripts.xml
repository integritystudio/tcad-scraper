  1: import { prisma } from "../lib/prisma";
  2: import { scraperQueue } from "../queues/scraper.queue";
  3: import { config } from "../config";
  4: import { getErrorMessage } from "../utils/error-helpers";
  5: import { RECENT_JOBS_LOOKBACK_MS, MIN_TERM_LENGTH } from "./lib/backfill-constants";
  6: const TARGET_2025_COUNT = 420_000;
  7: const BATCH_SIZE = 20;
  8: const POLL_INTERVAL_MS = 15_000;
  9: const MAX_CONSECUTIVE_ZERO_BATCHES = 3;
 10: async function get2025Count(): Promise<number> {
 11:   const result = await prisma.$queryRaw<[{ count: number }]>`
 12:     SELECT COUNT(*)::int as count FROM properties WHERE year = 2025`;
 13:   return result[0].count;
 14: }
 15: interface TermSets {
 16:   searched: Set<string>;
 17:   successful: Set<string>;
 18:   searched2025: Set<string>;
 19: }
 20: async function getTermSets(): Promise<TermSets> {
 21:   const analyticsRows = await prisma.searchTermAnalytics.findMany({
 22:     select: { searchTerm: true, totalResults: true },
 23:   });
 24:   const searched = new Set<string>();
 25:   const successful = new Set<string>();
 26:   for (const r of analyticsRows) {
 27:     const lower = r.searchTerm.toLowerCase();
 28:     searched.add(lower);
 29:     if (r.totalResults > 0) successful.add(lower);
 30:   }
 31:   const terms2025 = await prisma.$queryRaw<Array<{ search_term: string }>>`
 32:     SELECT DISTINCT search_term FROM properties WHERE year = 2025`;
 33:   const searched2025 = new Set(terms2025.map(r => r.search_term.toLowerCase()));
 34:   const recentJobs = await prisma.scrapeJob.findMany({
 35:     where: { startedAt: { gte: new Date(Date.now() - RECENT_JOBS_LOOKBACK_MS) } },
 36:     select: { searchTerm: true },
 37:   });
 38:   for (const j of recentJobs) {
 39:     searched2025.add(j.searchTerm.toLowerCase());
 40:     searched.add(j.searchTerm.toLowerCase());
 41:   }
 42:   return { searched, successful, searched2025 };
 43: }
 44: function isSupersetOfSuccessful(lower: string, successful: Set<string>): boolean {
 45:   for (let len = MIN_TERM_LENGTH; len < lower.length; len++) {
 46:     if (successful.has(lower.substring(0, len))) return true;
 47:   }
 48:   return false;
 49: }
 50: async function getUnsearchedTerms(): Promise<string[]> {
 51:   const { searched, successful, searched2025 } = await getTermSets();
 52:   const seen = new Set<string>();
 53:   const result: string[] = [];
 54:   let skippedSupersets = 0;
 55:   let skippedSearched = 0;
 56:   function addTerm(term: string): boolean {
 57:     if (term.length < MIN_TERM_LENGTH) return false;
 58:     const lower = term.toLowerCase();
 59:     if (searched.has(lower) || searched2025.has(lower) || seen.has(lower)) {
 60:       skippedSearched++;
 61:       return false;
 62:     }
 63:     if (isSupersetOfSuccessful(lower, successful)) {
 64:       skippedSupersets++;
 65:       return false;
 66:     }
 67:     seen.add(lower);
 68:     result.push(term);
 69:     return true;
 70:   }
 71:   console.log("  Mining owner first-words from 2026-only properties...");
