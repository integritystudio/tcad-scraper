212:   const candidates: string[] = [];
213:   const seen = new Set<string>();
214:   const tierResults: TierResult[] = [];
215:   function isSupersetOfSuccessful(lower: string): boolean {
216:     for (let len = MIN_TERM_LENGTH; len < lower.length; len++) {
217:       if (successful.has(lower.substring(0, len))) return true;
218:     }
219:     return false;
220:   }
221:   let skippedSupersets = 0;
222:   function addFromTier(tierName: string, terms: Iterable<string>): void {
223:     let added = 0;
224:     for (const term of terms) {
225:       if (candidates.length >= TARGET_TERM_COUNT) break;
226:       const lower = term.toLowerCase();
227:       if (searched.has(lower)) continue;
228:       if (seen.has(lower)) continue;
229:       if (term.length < MIN_TERM_LENGTH) continue;
230:       if (isSupersetOfSuccessful(lower)) { skippedSupersets++; continue; }
231:       seen.add(lower);
232:       candidates.push(term);
233:       added++;
234:     }
235:     tierResults.push({ name: tierName, count: added });
236:     console.log(`  ${tierName}: +${added} terms (total: ${candidates.length})`);
237:   }
238:   console.log(`\nTier 1: Expanding dense terms (successRate >= ${DENSE_MIN_SUCCESS_RATE * 100}%, baseLen <= ${DENSE_MAX_BASE_LENGTH})...`);
239:   const denseExpansions = await getDenseTermExpansions(searched);
240:   addFromTier("Dense expansions", denseExpansions);
241:   if (candidates.length < TARGET_TERM_COUNT) {
242:     console.log("Tier 2: Analytics seed prefix expansions...");
243:     const seedExpansions = await getAnalyticsSeedTerms(searched);
244:     addFromTier("Seed expansions", seedExpansions);
245:   }
246:   if (candidates.length < TARGET_TERM_COUNT) {
247:     console.log("Tier 3: Unexplored prefix gap analysis...");
248:     addFromTier("Gap prefixes", generateUnexploredPrefixes(searched));
249:   }
250:   if (candidates.length < TARGET_TERM_COUNT) {
251:     console.log("Tier 4: Static fallback arrays...");
252:     const fallbacks = getStaticFallbackTerms();
253:     addFromTier("Static fallbacks", fallbacks);
254:   }
255:   if (OUTPUT_JSON) {
256:     console.log("\n" + JSON.stringify(candidates, null, 2));
257:   } else {
258:     console.log("\n// ── Generated terms (paste into FALLBACK_TERMS or batch-configs) ──");
259:     const lines: string[] = [];
