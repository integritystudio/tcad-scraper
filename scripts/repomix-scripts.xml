<file path="enqueue-prefix-expansions.ts">
  1: import { PrismaClient } from '@prisma/client';
  2: import { scraperQueue } from '../queues/scraper.queue';
  3: import { config } from '../config';
  4: const prisma = new PrismaClient();
  5: const MAX_CONSECUTIVE_ZEROS = 3;
  6: const POLL_INTERVAL_MS = 5000;
  7: const BATCH_SIZE = 5;
  8: async function getPropertyCount(): Promise<number> {
  9:   return prisma.property.count({ where: { year: config.scraper.tcadYear } });
 10: }
 11: async function waitForQueueDrain(): Promise<void> {
 12:   while (true) {
 13:     const [waiting, active] = await Promise.all([
 14:       scraperQueue.getWaitingCount(),
 15:       scraperQueue.getActiveCount(),
 16:     ]);
 17:     if (waiting === 0 && active === 0) return;
 18:     await new Promise(r => setTimeout(r, POLL_INTERVAL_MS));
 19:   }
 20: }
 21: async function main() {
 22:   const analytics = await prisma.searchTermAnalytics.findMany({
 23:     where: {
 24:       avgResultsPerSearch: { gte: 500 },
 25:       successRate: { gte: 0.5 },
 26:       termLength: { lte: 5 },
 27:     },
 28:     orderBy: { avgResultsPerSearch: 'desc' },
 29:     select: { searchTerm: true, avgResultsPerSearch: true },
 30:   });
 31:   const [analyticsRows, propTermRows] = await Promise.all([
 32:     prisma.searchTermAnalytics.findMany({ select: { searchTerm: true } }),
 33:     prisma.property.groupBy({
 34:       by: ['searchTerm'],
 35:       where: { year: 2025, searchTerm: { not: null } },
 36:     }),
 37:   ]);
 38:   const searched = new Set<string>();
 39:   for (const r of analyticsRows) searched.add(r.searchTerm.toLowerCase());
 40:   for (const r of propTermRows) {
 41:     if (r.searchTerm) searched.add(r.searchTerm.toLowerCase());
 42:   }
 43:   const blacklisted = await prisma.searchTermAnalytics.findMany({
 44:     where: { successRate: 0, totalSearches: { gte: 3 } },
 45:     select: { searchTerm: true },
 46:   });
 47:   const blacklistSet = new Set(blacklisted.map(b => b.searchTerm.toLowerCase()));
 48:   const expansions: string[] = [];
 49:   const seen = new Set<string>();
 50:   for (const base of analytics) {
 51:     for (let c = 97; c <= 122; c++) {
 52:       const term = base.searchTerm + String.fromCharCode(c);
 53:       const lower = term.toLowerCase();
 54:       if (searched.has(lower) || blacklistSet.has(lower) || seen.has(lower)) continue;
 55:       if (term.length < 4) continue;
 56:       expansions.push(term);
 57:       seen.add(lower);
 58:     }
 59:   }
 60:   console.log(`Generated ${expansions.length} prefix expansion terms`);
 61:   console.log(`Max consecutive zeros before stop: ${MAX_CONSECUTIVE_ZEROS}`);
 62:   console.log(`Batch size: ${BATCH_SIZE}\n`);
 63:   let consecutiveZeros = 0;
 64:   let totalEnqueued = 0;
 65:   let totalNewProps = 0;
 66:   let idx = 0;
 67:   while (idx < expansions.length) {
 68:     const batch = expansions.slice(idx, idx + BATCH_SIZE);
 69:     idx += batch.length;
 70:     const beforeCount = await getPropertyCount();
 71:     for (const searchTerm of batch) {
 72:       await scraperQueue.add(
 73:         'scrape-properties',
 74:         { searchTerm, userId: 'prefix-expansion', scheduled: true },
 75:         {
 76:           attempts: 3,
 77:           backoff: { type: 'exponential', delay: 2000 },
 78:           removeOnComplete: 100,
 79:           removeOnFail: 50,
 80:         },
 81:       );
 82:     }
 83:     console.log(`Enqueued batch ${Math.ceil(idx / BATCH_SIZE)}: ${batch.join(', ')}`);
 84:     totalEnqueued += batch.length;
 85:     await waitForQueueDrain();
 86:     const afterCount = await getPropertyCount();
 87:     const newProps = afterCount - beforeCount;
 88:     totalNewProps += newProps;
 89:     if (newProps === 0) {
 90:       consecutiveZeros++;
 91:       console.log(`  -> 0 new properties (${consecutiveZeros}/${MAX_CONSECUTIVE_ZEROS} consecutive zeros)`);
 92:     } else {
 93:       consecutiveZeros = 0;
 94:       console.log(`  -> +${newProps} new properties (total DB: ${afterCount.toLocaleString()})`);
 95:     }
 96:     if (consecutiveZeros >= MAX_CONSECUTIVE_ZEROS) {
 97:       console.log(`\nSTOPPING: ${MAX_CONSECUTIVE_ZEROS} consecutive batches with 0 new properties`);
 98:       break;
 99:     }
100:   }
101:   console.log(`\n=== SUMMARY ===`);
102:   console.log(`Terms enqueued: ${totalEnqueued}`);
103:   console.log(`Terms remaining: ${expansions.length - idx}`);
104:   console.log(`New properties added: ${totalNewProps}`);
105:   console.log(`Final DB count: ${(await getPropertyCount()).toLocaleString()}`);
106:   await scraperQueue.close();
107:   await prisma.$disconnect();
108: }
109: main().catch(err => {
110:   console.error('Fatal:', err);
111:   process.exit(1);
112: });
</file>

