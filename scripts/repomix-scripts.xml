199:   console.log(`Target: ${TARGET_TERM_COUNT} new terms\n`);
200:   console.log("Fetching already-searched terms...");
201:   const analyticsRows = await prisma.searchTermAnalytics.findMany({
202:     select: { searchTerm: true, totalResults: true },
203:   });
204:   const searched = new Set<string>();
205:   const successful = new Set<string>();
206:   for (const r of analyticsRows) {
207:     const lower = r.searchTerm.toLowerCase();
208:     searched.add(lower);
209:     if (r.totalResults > 0) successful.add(lower);
