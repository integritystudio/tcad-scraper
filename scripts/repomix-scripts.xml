<file path="utils/list-all-search-terms.ts">
 1: import { BATCH_CONFIGS, HIGH_RESULT_TERM_SPLITS } from "../config/batch-configs";
 2: import { FALLBACK_TERMS } from "../continuous-batch-scraper";
 3: const NUMERIC_ONLY = /^\d+$/;
 4: function sortInsensitive(a: string, b: string): number {
 5: 	return a.localeCompare(b, undefined, { sensitivity: "base" });
 6: }
 7: export interface SearchTermInventory {
 8: 	all: string[];
 9: 	batchOnly: string[];
10: 	fallbackOnly: string[];
11: 	duplicated: string[];
12: }
13: export function getAllSearchTerms(): SearchTermInventory {
14: 	const batchSet = new Set<string>();
15: 	for (const config of Object.values(BATCH_CONFIGS)) {
16: 		for (const term of config.terms) {
17: 			if (!NUMERIC_ONLY.test(term)) batchSet.add(term);
18: 		}
19: 	}
20: 	for (const splits of HIGH_RESULT_TERM_SPLITS.values()) {
21: 		for (const term of splits) {
22: 			if (!NUMERIC_ONLY.test(term)) batchSet.add(term);
23: 		}
24: 	}
25: 	const batchLower = new Set([...batchSet].map((t) => t.toLowerCase()));
26: 	const fallbackSet = new Set<string>();
27: 	for (const term of FALLBACK_TERMS) {
28: 		if (!NUMERIC_ONLY.test(term)) fallbackSet.add(term);
29: 	}
30: 	const duplicated = [...fallbackSet]
31: 		.filter((t) => batchSet.has(t) || batchLower.has(t.toLowerCase()))
32: 		.sort(sortInsensitive);
33: 	const batchOnly = [...batchSet]
34: 		.filter((t) => !fallbackSet.has(t))
35: 		.sort(sortInsensitive);
36: 	const fallbackOnly = [...fallbackSet]
37: 		.filter((t) => !batchSet.has(t) && !batchLower.has(t.toLowerCase()))
38: 		.sort(sortInsensitive);
39: 	const seenLower = new Set<string>();
40: 	const all: string[] = [];
41: 	for (const term of [...batchSet, ...fallbackSet]) {
42: 		if (NUMERIC_ONLY.test(term)) continue;
43: 		const lower = term.toLowerCase();
44: 		if (seenLower.has(lower)) continue;
45: 		seenLower.add(lower);
46: 		all.push(term);
47: 	}
48: 	all.sort(sortInsensitive);
49: 	return { all, batchOnly, fallbackOnly, duplicated };
50: }
51: function printRows(terms: string[], indent = "  ", perRow = 10): void {
52: 	for (let i = 0; i < terms.length; i += perRow) {
53: 		console.log(indent + terms.slice(i, i + perRow).join(", "));
54: 	}
55: }
56: if (require.main === module) {
57: 	const { all, batchOnly, fallbackOnly, duplicated } = getAllSearchTerms();
58: 	console.log("=== SEARCH TERM INVENTORY (DEDUPED) ===\n");
59: 	console.log(`Total unique non-numeric terms: ${all.length}`);
60: 	console.log(`  batch-configs only: ${batchOnly.length}`);
61: 	console.log(`  fallback only:      ${fallbackOnly.length}`);
62: 	console.log(`  duplicated:         ${duplicated.length}\n`);
63: 	console.log(`--- batch-configs only (${batchOnly.length}) ---`);
64: 	printRows(batchOnly);
65: 	console.log();
66: 	console.log(`--- fallback only (${fallbackOnly.length}) ---`);
67: 	printRows(fallbackOnly);
68: 	console.log();
69: 	console.log(`--- duplicated across files (${duplicated.length}) ---`);
70: 	printRows(duplicated);
71: 	console.log();
72: 	console.log(`=== FULL DEDUPED LIST (${all.length}) ===`);
73: 	printRows(all, "", 10);
74: }
</file>

