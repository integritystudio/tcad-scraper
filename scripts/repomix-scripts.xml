<file path="requeue/requeue-all-failed-with-error-tracking.ts">
  1: #!/usr/bin/env npx tsx
  2: import * as fs from "node:fs";
  3: import * as path from "node:path";
  4: import logger from "../../lib/logger";
  5: import { prisma } from "../../lib/prisma";
  6: import { scraperQueue } from "../../queues/scraper.queue";
  7: import { tokenRefreshService } from "../../services/token-refresh.service";
  8: import { getErrorMessage } from "../../utils/error-helpers";
  9: const THREE_MINUTES_MS = 3 * 60 * 1000;
 10: const BATCH_SIZE = 50;
 11: interface ErrorStats {
 12: 	category: string;
 13: 	count: number;
 14: 	examples: string[];
 15: }
 16: async function categorizeErrors(): Promise<Map<string, ErrorStats>> {
 17: 	logger.info("📊 Analyzing failed job errors...");
 18: 	const failedJobs = await prisma.scrapeJob.findMany({
 19: 		where: {
 20: 			status: "failed",
 21: 		},
 22: 		select: {
 23: 			error: true,
 24: 			searchTerm: true,
 25: 		},
 26: 	});
 27: 	const errorMap = new Map<string, ErrorStats>();
 28: 	for (const job of failedJobs) {
 29: 		if (!job.error) continue;
 30: 		let category = "Unknown Error";
 31: 		if (job.error.includes("HTTP 401")) {
 32: 			category = "HTTP 401 Unauthorized";
 33: 		} else if (job.error.includes("HTTP 409")) {
 34: 			category = "HTTP 409 Conflict (Rate Limit)";
 35: 		} else if (job.error.includes("HTTP 504")) {
 36: 			category = "HTTP 504 Gateway Timeout";
 37: 		} else if (job.error.includes("HTTP 500")) {
 38: 			category = "HTTP 500 Internal Server Error";
 39: 		} else if (job.error.includes("search_term_analytics")) {
 40: 			category = "Missing search_term_analytics Table";
 41: 		} else if (job.error.includes("Cannot affect row a second time")) {
 42: 			category = "Duplicate Constraint Violation";
 43: 		} else if (job.error.includes("Unexpected end of JSON input")) {
 44: 			category = "JSON Parsing Error";
 45: 		} else if (job.error.includes("Failed to intercept")) {
 46: 			category = "API Interception Failed";
 47: 		} else if (job.error.includes("timeout")) {
 48: 			category = "Timeout Error";
 49: 		} else if (job.error.includes("Raw query failed")) {
 50: 			category = "Database Raw Query Error";
 51: 		} else {
 52: 			category = job.error.substring(0, 80).replace(/\n/g, " ");
 53: 		}
 54: 		if (!errorMap.has(category)) {
 55: 			errorMap.set(category, {
 56: 				category,
 57: 				count: 0,
 58: 				examples: [],
 59: 			});
 60: 		}
 61: 		const stats = errorMap.get(category)!;
 62: 		stats.count++;
 63: 		if (stats.examples.length < 5) {
 64: 			stats.examples.push(job.searchTerm);
 65: 		}
 66: 	}
 67: 	return errorMap;
 68: }
 69: async function saveErrorReport(
 70: 	errorMap: Map<string, ErrorStats>,
 71: ): Promise<string> {
 72: 	const reportData = {
 73: 		timestamp: new Date().toISOString(),
 74: 		totalFailedJobs: Array.from(errorMap.values()).reduce(
 75: 			(sum, stat) => sum + stat.count,
 76: 			0,
 77: 		),
 78: 		errorBreakdown: Array.from(errorMap.values()).sort(
 79: 			(a, b) => b.count - a.count,
 80: 		),
 81: 	};
 82: 	const dataDir = path.join(process.cwd(), "data");
 83: 	const reportPath = path.join(dataDir, `error-report-${Date.now()}.json`);
 84: 	if (!fs.existsSync(dataDir)) {
 85: 		fs.mkdirSync(dataDir, { recursive: true });
 86: 	}
 87: 	fs.writeFileSync(reportPath, JSON.stringify(reportData, null, 2));
 88: 	return reportPath;
 89: }
 90: async function main() {
 91: 	logger.info("🔄 Re-queue All Failed Jobs with Error Tracking");
 92: 	logger.info("=".repeat(60));
 93: 	try {
 94: 		logger.info("\n📊 Step 1: Categorizing failed job errors...");
 95: 		const errorMap = await categorizeErrors();
 96: 		const totalFailed = Array.from(errorMap.values()).reduce(
 97: 			(sum, stat) => sum + stat.count,
 98: 			0,
 99: 		);
100: 		logger.info(`   Total failed jobs: ${totalFailed}`);
101: 		logger.info(`   Unique error categories: ${errorMap.size}`);
102: 		logger.info("\n   Error Breakdown:");
103: 		Array.from(errorMap.values())
104: 			.sort((a, b) => b.count - a.count)
105: 			.forEach((stat) => {
106: 				const percentage = ((stat.count / totalFailed) * 100).toFixed(1);
107: 				logger.info(`   - ${stat.category}: ${stat.count} (${percentage}%)`);
108: 			});
109: 		logger.info("\n💾 Step 2: Saving error report...");
110: 		const reportPath = await saveErrorReport(errorMap);
111: 		logger.info(`   ✅ Report saved to: ${reportPath}`);
112: 		logger.info("\n📋 Step 3: Collecting unique search terms to re-queue...");
113: 		const failedJobs = await prisma.scrapeJob.findMany({
114: 			where: {
115: 				status: "failed",
116: 			},
117: 			select: { searchTerm: true },
118: 			distinct: ["searchTerm"],
119: 		});
120: 		const termsToRequeue = failedJobs.map((job) => job.searchTerm);
121: 		logger.info(
122: 			`   Found ${termsToRequeue.length} unique search terms to re-queue`,
123: 		);
124: 		if (termsToRequeue.length === 0) {
125: 			logger.info("\n✅ No jobs to re-queue!");
126: 			await cleanup();
127: 			return;
128: 		}
129: 		logger.info("\n🧹 Step 4: Cleaning up failed jobs from queue...");
130: 		const cleanedFailed = await scraperQueue.clean(0, "failed");
131: 		logger.info(`   ✅ Cleaned ${cleanedFailed.length} failed jobs from queue`);
132: 		logger.info("\n🔑 Step 5: Refreshing API token...");
133: 		const newToken = await tokenRefreshService.refreshToken();
134: 		if (!newToken) {
135: 			logger.error("   ❌ Failed to refresh token!");
136: 			await cleanup();
137: 			process.exit(1);
138: 		}
139: 		logger.info(
140: 			`   ✅ Token refreshed successfully (length: ${newToken.length})`,
141: 		);
142: 		logger.info("\n⏰ Step 6: Starting auto-refresh (every 3 minutes)...");
143: 		tokenRefreshService.startAutoRefreshInterval(THREE_MINUTES_MS);
144: 		logger.info("   ✅ Auto-refresh started");
145: 		logger.info(
146: 			`\n🚀 Step 7: Re-enqueueing ${termsToRequeue.length} jobs in batches of ${BATCH_SIZE}...`,
147: 		);
148: 		let enqueued = 0;
149: 		for (let i = 0; i < termsToRequeue.length; i += BATCH_SIZE) {
150: 			const batch = termsToRequeue.slice(i, i + BATCH_SIZE);
151: 			const batchNum = Math.floor(i / BATCH_SIZE) + 1;
152: 			const totalBatches = Math.ceil(termsToRequeue.length / BATCH_SIZE);
153: 			logger.info(
154: 				`   Batch ${batchNum}/${totalBatches}: Enqueueing ${batch.length} jobs...`,
155: 			);
156: 			for (const term of batch) {
157: 				try {
158: 					await scraperQueue.add(
159: 						"scrape-properties",
160: 						{
161: 							searchTerm: term,
162: 							userId: "requeue-all-failed",
163: 							scheduled: false,
164: 						},
165: 						{
166: 							priority: 5,
167: 							attempts: 3,
168: 							backoff: {
169: 								type: "exponential",
170: 								delay: 2000,
171: 							},
172: 							removeOnComplete: false,
173: 							removeOnFail: false,
174: 						},
175: 					);
176: 					enqueued++;
177: 				} catch (error: unknown) {
178: 					logger.error(
179: 						`   ❌ Failed to enqueue "${term}": ${getErrorMessage(error)}`,
180: 					);
181: 				}
182: 			}
183: 			logger.info(
184: 				`   ✅ Batch ${batchNum}/${totalBatches} enqueued (${enqueued} total)`,
185: 			);
186: 			if (i + BATCH_SIZE < termsToRequeue.length) {
187: 				await new Promise((resolve) => setTimeout(resolve, 1000));
188: 			}
189: 		}
190: 		logger.info(`\n   ✅ Enqueued ${enqueued} jobs successfully`);
191: 		logger.info("\n📊 Step 8: Final queue status...");
192: 		const [finalWaiting, finalActive, finalDelayed] = await Promise.all([
193: 			scraperQueue.getWaitingCount(),
194: 			scraperQueue.getActiveCount(),
195: 			scraperQueue.getDelayedCount(),
196: 		]);
197: 		logger.info(`   - Waiting: ${finalWaiting}`);
198: 		logger.info(`   - Active: ${finalActive}`);
199: 		logger.info(`   - Delayed: ${finalDelayed}`);
200: 		logger.info(`   - Total: ${finalWaiting + finalActive + finalDelayed}`);
201: 		logger.info("\n✅ Re-queue complete!");
202: 		logger.info("\n📄 Error Report Summary:");
203: 		logger.info(`   Total Failed Jobs: ${totalFailed}`);
204: 		logger.info(`   Unique Error Categories: ${errorMap.size}`);
205: 		logger.info(`   Report Location: ${reportPath}`);
206: 		logger.info("\n⚠️  IMPORTANT: Auto-refresh is running every 3 minutes.");
207: 		logger.info(
208: 			"   The script will continue running to maintain token refresh.",
209: 		);
210: 		logger.info("   Press Ctrl+C to stop when done.\n");
211: 		process.on("SIGINT", async () => {
212: 			logger.info("\n\n👋 Shutting down...");
213: 			await cleanup();
214: 			process.exit(0);
215: 		});
216: 		process.on("SIGTERM", async () => {
217: 			logger.info("\n\n👋 Shutting down...");
218: 			await cleanup();
219: 			process.exit(0);
220: 		});
221: 		await new Promise(() => {});
222: 	} catch (error) {
223: 		logger.error(error as Error, "\n❌ Script failed");
224: 		await cleanup();
225: 		process.exit(1);
226: 	}
227: }
228: async function cleanup() {
229: 	logger.info("Cleaning up...");
230: 	await tokenRefreshService.cleanup();
231: 	await scraperQueue.close();
232: 	await prisma.$disconnect();
233: 	logger.info("Cleanup complete");
234: }
235: main().catch(async (error) => {
236: 	logger.error("Fatal error:", error);
237: 	await cleanup();
238: 	process.exit(1);
239: });
</file>

