272:     for (const term of candidates) {
273:       try {
274:         await scraperQueue.add(
275:           jobName,
276:           { searchTerm: term, userId: "generate-search-terms", scheduled: true },
277:           {
278:             attempts: defaultJobOptions.attempts,
279:             backoff: { type: "exponential", delay: defaultJobOptions.backoffDelay },
280:             removeOnComplete: defaultJobOptions.removeOnComplete,
281:             removeOnFail: defaultJobOptions.removeOnFail,
282:           },
283:         );
284:         enqueued++;
285:       } catch (error) {
286:         console.error(`  Failed to enqueue "${term}": ${getErrorMessage(error)}`);
287:       }
288:     }
289:     console.log(`  Enqueued ${enqueued}/${candidates.length} terms`);
290:   }
291:   console.log(`\n=== Summary ===`);
292:   console.log(`  Total generated: ${candidates.length}`);
293:   console.log(`  Already searched: ${searched.size} (${successful.size} successful)`);
294:   console.log(`  Skipped supersets: ${skippedSupersets}`);
