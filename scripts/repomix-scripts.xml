 86: async function getDenseTermExpansions(searched: Set<string>): Promise<string[]> {
 87:   const dense = await prisma.searchTermAnalytics.findMany({
 88:     where: {
 89:       OR: [
 90:         { maxResults: { gte: DENSE_MAX_RESULTS_THRESHOLD } },
 91:         { avgResultsPerSearch: { gte: DENSE_AVG_RESULTS_THRESHOLD } },
 92:       ],
 93:       successRate: { gte: DENSE_MIN_SUCCESS_RATE },
 94:     },
 95:     orderBy: { avgResultsPerSearch: "desc" },
 96:     select: { searchTerm: true, maxResults: true, avgResultsPerSearch: true, successRate: true },
 97:   });
 98:   const expansions: string[] = [];
 99:   const seen = new Set<string>();
100:   for (const row of dense) {
101:     const base = row.searchTerm;
102:     if (base.length > DENSE_MAX_BASE_LENGTH) continue;
103:     for (const ch of ALPHABET) {
104:       const expanded = base + ch;
105:       const lower = expanded.toLowerCase();
106:       if (expanded.length < MIN_TERM_LENGTH) continue;
107:       if (searched.has(lower)) continue;
108:       if (seen.has(lower)) continue;
109:       seen.add(lower);
110:       expansions.push(expanded);
111:     }
112:   }
113:   return expansions;
114: }
115: async function getAnalyticsSeedTerms(searched: Set<string>): Promise<string[]> {
116:   const highYield = await prisma.searchTermAnalytics.findMany({
117:     where: {
118:       successRate: { gte: SEED_MIN_SUCCESS_RATE },
119:       avgResultsPerSearch: { gte: SEED_MIN_AVG_RESULTS },
120:     },
121:     orderBy: { avgResultsPerSearch: "desc" },
122:     select: { searchTerm: true },
123:   });
124:   const prefixes = new Set<string>();
125:   for (const row of highYield) {
126:     if (row.searchTerm.length >= MIN_TERM_LENGTH) {
127:       prefixes.add(row.searchTerm.substring(0, MIN_TERM_LENGTH).toLowerCase());
128:     }
129:   }
130:   const expansions: string[] = [];
131:   const seen = new Set<string>();
132:   for (const prefix of prefixes) {
133:     for (const ch of ALPHABET) {
134:       const expanded = prefix + ch;
135:       if (searched.has(expanded)) continue;
136:       if (seen.has(expanded)) continue;
137:       seen.add(expanded);
138:       expansions.push(expanded);
139:     }
140:   }
141:   return expansions;
142: }
143: function* generateUnexploredPrefixes(searched: Set<string>): Generator<string> {
144:   const searchedPrefixes = new Set<string>();
145:   for (const term of searched) {
146:     if (term.length >= MIN_TERM_LENGTH) {
147:       searchedPrefixes.add(term.substring(0, MIN_TERM_LENGTH));
148:     }
149:   }
150:   const HIGH_FREQ_FIRST = "abcdefghjklmnoprstw";
151:   const CONSONANTS = "bcdfghjklmnpqrstvwxyz";
152:   const VOWELS = "aeiou";
153:   const shuffled1 = [...HIGH_FREQ_FIRST].sort((a, b) => simpleHash("1" + a) - simpleHash("1" + b));
154:   const shuffled2 = [...ALPHABET].sort((a, b) => simpleHash("2" + a) - simpleHash("2" + b));
155:   const shuffled3 = [...ALPHABET].sort((a, b) => simpleHash("3" + a) - simpleHash("3" + b));
156:   const shuffled4 = [...ALPHABET].sort((a, b) => simpleHash("4" + a) - simpleHash("4" + b));
157:   const seen = new Set<string>();
158:   for (const c1 of shuffled1) {
159:     for (const c2 of shuffled2) {
160:       for (const c3 of shuffled3) {
161:         const first3 = c1 + c2 + c3;
162:         const hasVowel = [...first3].some((ch) => VOWELS.includes(ch));
163:         const hasConsonant = [...first3].some((ch) => CONSONANTS.includes(ch));
164:         if (!hasVowel || !hasConsonant) continue;
165:         for (const c4 of shuffled4) {
166:           const prefix = c1 + c2 + c3 + c4;
167:           if (searchedPrefixes.has(prefix)) continue;
168:           if (searched.has(prefix)) continue;
169:           if (seen.has(prefix)) continue;
170:           seen.add(prefix);
171:           yield prefix;
172:         }
173:       }
174:     }
175:   }
176: }
177: function simpleHash(s: string): number {
178:   let h = 0;
179:   for (let i = 0; i < s.length; i++) {
180:     h = ((h << 5) - h + s.charCodeAt(i)) | 0;
181:   }
182:   return h;
183: }
184: function getStaticFallbackTerms(): string[] {
185:   return [
186:     ...FIRST_NAMES,
187:     ...LAST_NAMES,
188:     ...GEOGRAPHIC_TERMS,
189:     ...ENTITY_TERMS,
190:     ...NEIGHBORHOOD_TERMS,
191:   ];
192: }
