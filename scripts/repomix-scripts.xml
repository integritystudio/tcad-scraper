<file path="run-until-target.ts">
  1: import { config } from "../config";
  2: import { prisma } from "../lib/prisma";
  3: import { scraperQueue } from "../queues/scraper.queue";
  4: import { TermSelector } from "./continuous-batch-scraper";
  5: import { getErrorMessage } from "../utils/error-helpers";
  6: const TARGET = 400_000;
  7: const MAX_CONSECUTIVE_ZEROS = 5;
  8: const BATCH_SIZE = 10;
  9: const POLL_INTERVAL_MS = 5_000;
 10: const MAX_JOB_WAIT_MS = 300_000;
 11: async function getYearCount(): Promise<number> {
 12:   return prisma.property.count({ where: { year: config.scraper.tcadYear } });
 13: }
 14: async function waitForJobs(jobIds: { id: string; term: string }[]): Promise<{ term: string; count: number; failed: boolean }[]> {
 15:   const start = Date.now();
 16:   while (Date.now() - start < MAX_JOB_WAIT_MS) {
 17:     const states = await Promise.all(
 18:       jobIds.map(async (j) => {
 19:         const job = await scraperQueue.getJob(j.id);
 20:         return job ? await job.getState() : "unknown";
 21:       }),
 22:     );
 23:     const done = states.filter((s) => s === "completed" || s === "failed").length;
 24:     if (done >= jobIds.length) break;
 25:     await new Promise((r) => setTimeout(r, POLL_INTERVAL_MS));
 26:   }
 27:   const results: { term: string; count: number; failed: boolean }[] = [];
 28:   for (const { id, term } of jobIds) {
 29:     const job = await scraperQueue.getJob(id);
 30:     if (!job) { results.push({ term, count: 0, failed: true }); continue; }
 31:     const state = await job.getState();
 32:     if (state === "failed") {
 33:       results.push({ term, count: 0, failed: true });
 34:     } else {
 35:       const rv = job.returnvalue;
 36:       results.push({ term, count: rv?.count ?? 0, failed: false });
 37:     }
 38:   }
 39:   return results;
 40: }
 41: async function main() {
 42:   const year = config.scraper.tcadYear;
 43:   const startCount = await getYearCount();
 44:   console.log(`\n=== Run until ${TARGET.toLocaleString()} properties (year=${year}) ===`);
 45:   console.log(`Starting count: ${startCount.toLocaleString()}\n`);
 46:   if (startCount >= TARGET) {
 47:     console.log("Target already reached.");
 48:     await prisma.$disconnect();
 49:     process.exit(0);
 50:   }
 51:   const selector = new TermSelector();
 52:   let consecutiveZeros = 0;
 53:   let totalJobsRun = 0;
 54:   let totalNew = 0;
 55:   const startTime = Date.now();
 56:   while (true) {
 57:     const currentCount = await getYearCount();
 58:     if (currentCount >= TARGET) {
 59:       console.log(`\nTARGET REACHED: ${currentCount.toLocaleString()} properties`);
 60:       break;
 61:     }
 62:     const terms = await selector.getNextBatch(BATCH_SIZE);
 63:     if (terms.length === 0) {
 64:       console.log("\nNo more terms available.");
 65:       break;
 66:     }
 67:     console.log(`\n--- Batch (${terms.length} terms): ${terms.join(", ")} ---`);
 68:     const jobIds: { id: string; term: string }[] = [];
 69:     for (const term of terms) {
 70:       const job = await scraperQueue.add(
 71:         "scrape-properties",
 72:         { searchTerm: term, userId: "run-until-target", scheduled: true },
 73:         { attempts: 3, backoff: { type: "exponential", delay: 2000 }, removeOnComplete: false, removeOnFail: false },
 74:       );
 75:       jobIds.push({ id: job.id.toString(), term });
 76:     }
 77:     const results = await waitForJobs(jobIds);
 78:     for (const r of results) {
 79:       totalJobsRun++;
 80:       const tag = r.failed ? "FAILED" : `count=${r.count}`;
 81:       console.log(`  "${r.term}" -> ${tag}`);
 82:       if (r.failed || r.count === 0) {
 83:         consecutiveZeros++;
 84:       } else {
 85:         consecutiveZeros = 0;
 86:         totalNew += r.count;
 87:       }
 88:       if (consecutiveZeros >= MAX_CONSECUTIVE_ZEROS) {
 89:         console.log(`\nSTOPPED: ${MAX_CONSECUTIVE_ZEROS} consecutive zero-result/failed jobs`);
 90:         break;
 91:       }
 92:     }
 93:     if (consecutiveZeros >= MAX_CONSECUTIVE_ZEROS) break;
 94:     const elapsed = Math.round((Date.now() - startTime) / 1000);
 95:     const current = await getYearCount();
 96:     console.log(`  [${elapsed}s] ${current.toLocaleString()} properties (+${(current - startCount).toLocaleString()}) | jobs=${totalJobsRun} | streak=${consecutiveZeros}`);
 97:   }
 98:   const finalCount = await getYearCount();
 99:   const elapsed = Math.round((Date.now() - startTime) / 1000);
100:   console.log(`\n=== FINAL REPORT ===`);
101:   console.log(`  Runtime: ${Math.floor(elapsed / 60)}m ${elapsed % 60}s`);
102:   console.log(`  Start: ${startCount.toLocaleString()} -> Final: ${finalCount.toLocaleString()} (+${(finalCount - startCount).toLocaleString()})`);
103:   console.log(`  Jobs run: ${totalJobsRun}`);
104:   console.log(`  Year: ${year}`);
105:   await scraperQueue.close();
106:   await prisma.$disconnect();
107:   process.exit(0);
108: }
109: main().catch((err) => {
110:   console.error("Fatal:", getErrorMessage(err));
111:   process.exit(1);
112: });
</file>

