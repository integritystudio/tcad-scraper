<file path="continuous-batch-scraper-lowthreshold.ts">
  1: import winston from "winston";
  2: import { config } from "../config";
  3: import { prisma } from "../lib/prisma";
  4: import { scraperQueue } from "../queues/scraper.queue";
  5: import { getErrorMessage } from "../utils/error-helpers";
  6: import { LOW_THRESHOLD_TIER_CONFIG, TermSelector } from "./continuous-batch-scraper";
  7: const STOP_AT_PROPERTIES = 420000;
  8: const MAX_CONSECUTIVE_ZERO_BATCHES = 3;
  9: const BATCH_SIZE = 25;
 10: const DELAY_BETWEEN_BATCHES = 30000;
 11: const CHECK_INTERVAL = 60000;
 12: const logger = winston.createLogger({
 13: 	level: "info",
 14: 	format: winston.format.combine(
 15: 		winston.format.timestamp(),
 16: 		winston.format.simple(),
 17: 	),
 18: 	transports: [
 19: 		new winston.transports.Console(),
 20: 		new winston.transports.File({ filename: "logs/continuous-scraper-lowthreshold.log" }),
 21: 	],
 22: });
 23: class LowThresholdScraper {
 24: 	private termSelector = new TermSelector(LOW_THRESHOLD_TIER_CONFIG);
 25: 	private stats = {
 26: 		totalQueued: 0,
 27: 		batchesProcessed: 0,
 28: 		startTime: Date.now(),
 29: 		startingPropertyCount: 0,
 30: 	};
 31: 	private running = true;
 32: 	private consecutiveZeroBatches = 0;
 33: 	private lastPropertyCount = 0;
 34: 	private countProperties() {
 35: 		return prisma.property.count({ where: { year: config.scraper.tcadYear } });
 36: 	}
 37: 	async run() {
 38: 		logger.info("=============================================");
 39: 		logger.info("  LOW-THRESHOLD CONTINUOUS SCRAPER (long tail)");
 40: 		logger.info("=============================================\n");
 41: 		const pendingCount = await scraperQueue.getWaitingCount();
 42: 		if (pendingCount > 0) {
 43: 			await scraperQueue.clean(0, "wait");
 44: 			logger.info(`Cleared ${pendingCount} pending jobs`);
 45: 		}
 46: 		this.stats.startingPropertyCount = await this.countProperties();
 47: 		this.lastPropertyCount = this.stats.startingPropertyCount;
 48: 		logger.info(`Starting: ${this.stats.startingPropertyCount.toLocaleString()}`);
 49: 		logger.info(`Stop at: ${STOP_AT_PROPERTIES.toLocaleString()} or ${MAX_CONSECUTIVE_ZERO_BATCHES} consecutive zero-result batches`);
 50: 		logger.info(`Remaining: ${(STOP_AT_PROPERTIES - this.stats.startingPropertyCount).toLocaleString()}\n`);
 51: 		process.on("SIGINT", () => this.stop());
 52: 		process.on("SIGTERM", () => this.stop());
 53: 		this.startMonitoring();
 54: 		while (this.running) {
 55: 			const currentCount = await this.countProperties();
 56: 			if (currentCount >= STOP_AT_PROPERTIES) {
 57: 				logger.info(`STOP TARGET REACHED! Current count: ${currentCount.toLocaleString()}`);
 58: 				break;
 59: 			}
 60: 			const newSinceLastCheck = currentCount - this.lastPropertyCount;
 61: 			if (this.stats.batchesProcessed > 0 && newSinceLastCheck === 0) {
 62: 				this.consecutiveZeroBatches++;
 63: 				logger.warn(`Zero new properties (${this.consecutiveZeroBatches}/${MAX_CONSECUTIVE_ZERO_BATCHES} consecutive)`);
 64: 				if (this.consecutiveZeroBatches >= MAX_CONSECUTIVE_ZERO_BATCHES) {
 65: 					logger.info(`STOPPING: ${MAX_CONSECUTIVE_ZERO_BATCHES} consecutive batches with zero new properties`);
 66: 					break;
 67: 				}
 68: 			} else if (newSinceLastCheck > 0) {
 69: 				this.consecutiveZeroBatches = 0;
 70: 			}
 71: 			this.lastPropertyCount = currentCount;
 72: 			const [waiting, active] = await Promise.all([
 73: 				scraperQueue.getWaitingCount(),
 74: 				scraperQueue.getActiveCount(),
 75: 			]);
 76: 			if (waiting + active < 100) {
 77: 				await this.queueBatch();
 78: 			} else {
 79: 				logger.info(`Queue full (${waiting} waiting, ${active} active). Waiting...`);
 80: 			}
 81: 			await this.delay(DELAY_BETWEEN_BATCHES);
 82: 		}
 83: 		await this.printFinalReport();
 84: 		process.exit(0);
 85: 	}
 86: 	private async queueBatch() {
 87: 		const searchTerms = await this.termSelector.getNextBatch(BATCH_SIZE);
 88: 		this.stats.batchesProcessed++;
 89: 		logger.info(`Batch #${this.stats.batchesProcessed} (${searchTerms.length} terms)`);
 90: 		for (const searchTerm of searchTerms) {
 91: 			try {
 92: 				await scraperQueue.add(
 93: 					"scrape-properties",
 94: 					{
 95: 						searchTerm,
 96: 						userId: "lowthreshold-batch",
 97: 						scheduled: true,
 98: 					},
 99: 					{
100: 						attempts: 3,
101: 						backoff: { type: "exponential", delay: 2000 },
102: 						removeOnComplete: 100,
103: 						removeOnFail: 50,
104: 					},
105: 				);
106: 				this.stats.totalQueued++;
107: 			} catch (error) {
108: 				logger.error(`Failed to queue ${searchTerm}: ${getErrorMessage(error)}`);
109: 			}
110: 		}
111: 		logger.info(`Queued ${searchTerms.length} jobs (Total: ${this.stats.totalQueued})`);
112: 	}
113: 	private startMonitoring() {
114: 		setInterval(async () => {
115: 			try {
116: 				const [currentCount, waiting, active, completed, failed] =
117: 					await Promise.all([
118: 						this.countProperties(),
119: 						scraperQueue.getWaitingCount(),
120: 						scraperQueue.getActiveCount(),
121: 						scraperQueue.getCompletedCount(),
122: 						scraperQueue.getFailedCount(),
123: 					]);
124: 				const newProperties = currentCount - this.stats.startingPropertyCount;
125: 				const progress = (currentCount / STOP_AT_PROPERTIES) * 100;
126: 				const elapsed = Math.floor((Date.now() - this.stats.startTime) / 1000);
127: 				const hours = Math.floor(elapsed / 3600);
128: 				const minutes = Math.floor((elapsed % 3600) / 60);
129: 				const rate = newProperties / (elapsed / 60);
130: 				logger.info(
131: 					`[${hours}h ${minutes}m] ${progress.toFixed(2)}% | ` +
132: 					`DB: ${currentCount.toLocaleString()} (+${newProperties.toLocaleString()}) | ` +
133: 					`Queue: ${waiting}w/${active}a/${completed}c/${failed}f | ` +
134: 					`${rate.toFixed(1)} props/min`,
135: 				);
136: 				if (rate > 0) {
137: 					const remaining = STOP_AT_PROPERTIES - currentCount;
138: 					const hoursRemaining = remaining / rate / 60;
139: 					logger.info(`ETA: ${hoursRemaining.toFixed(1)} hours`);
140: 				}
141: 			} catch (error) {
142: 				logger.error(`Monitoring error: ${getErrorMessage(error)}`);
143: 			}
144: 		}, CHECK_INTERVAL);
145: 	}
146: 	private async printFinalReport() {
147: 		const finalCount = await this.countProperties();
148: 		const elapsed = Math.floor((Date.now() - this.stats.startTime) / 1000);
149: 		const hours = Math.floor(elapsed / 3600);
150: 		const minutes = Math.floor((elapsed % 3600) / 60);
151: 		logger.info("\n=== FINAL REPORT ===");
152: 		logger.info(`Runtime: ${hours}h ${minutes}m`);
153: 		logger.info(`Starting: ${this.stats.startingPropertyCount.toLocaleString()}`);
154: 		logger.info(`Final: ${finalCount.toLocaleString()}`);
155: 		logger.info(`Added: ${(finalCount - this.stats.startingPropertyCount).toLocaleString()}`);
156: 		logger.info(`Jobs queued: ${this.stats.totalQueued.toLocaleString()}`);
157: 		logger.info(`Batches: ${this.stats.batchesProcessed}`);
158: 	}
159: 	private stop() {
160: 		logger.info("Stopping low-threshold scraper...");
161: 		this.running = false;
162: 	}
163: 	private delay(ms: number): Promise<void> {
164: 		return new Promise((resolve) => setTimeout(resolve, ms));
165: 	}
166: }
167: if (require.main === module) {
168: 	const scraper = new LowThresholdScraper();
169: 	scraper.run().catch((error) => {
170: 		logger.error(`Fatal error: ${getErrorMessage(error)}`);
171: 		process.exit(1);
172: 	});
173: }
</file>

