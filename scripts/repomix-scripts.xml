323:   • Unique Properties: ${dbStats.uniqueProperties}
324:   • Deduplication Rate: ${(((dbStats.totalProperties - dbStats.uniqueProperties) / dbStats.totalProperties) * 100).toFixed(2)}%
325:   • Total Scrape Jobs: ${dbStats.totalJobs}
326:   • Overall Success Rate: ${dbStats.successRate}%
327: Performance:
328:   • Avg Time per Job: ${(elapsed / this.stats.totalCompleted).toFixed(2)}s
329:   • Properties per Minute: ${((dbStats.totalProperties / elapsed) * 60).toFixed(2)}
330: Strategy Used: ${this.config.searchStrategy}
331:     `);
332: 	}
333: 	async run(): Promise<void> {
334: 		try {
335: 			logger.info("╔════════════════════════════════════════════════════════╗");
336: 			logger.info("║        TCAD BATCH SCRAPER - Starting...                ║");
337: 			logger.info(
338: 				"╚════════════════════════════════════════════════════════╝\n",
339: 			);
340: 			await this.queueJobs();
341: 			await this.monitorProgress();
342: 			logger.info("\n✓ Batch scraping completed successfully!");
343: 			process.exit(0);
344: 		} catch (error) {
345: 			logger.error(
