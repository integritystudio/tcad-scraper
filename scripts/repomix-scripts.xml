17: export async function enqueueBatchGeneric(
18: 	batchConfig: BatchEnqueueConfig,
19: ): Promise<BatchEnqueueResult> {
20: 	const { batchName, emoji, terms, userId, priority, extraLogs } = batchConfig;
21: 	logger.info(`${emoji} Starting ${batchName} Batch Enqueue`);
22: 	logger.info(`TCAD API token: ${config.scraper.tcadApiKey ? "configured" : "NOT configured"}`);
