 2: import logger from "../../lib/logger";
 3: import { scraperQueue } from "../../queues/scraper.queue";
 4: export interface BatchEnqueueConfig {
 5: 	batchName: string;
 6: 	emoji: string;
 7: 	terms: string[];
 8: 	userId: string;
 9: 	priority?: number;
