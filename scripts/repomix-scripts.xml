203: 			const batch = searchTerms.slice(i, i + this.config.batchSize);
204: 			logger.info(
205: 				`\nQueuing batch ${Math.floor(i / this.config.batchSize) + 1}/${Math.ceil(searchTerms.length / this.config.batchSize)}`,
206: 			);
