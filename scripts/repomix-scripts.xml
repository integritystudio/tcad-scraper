<file path="check-queue-status.ts">
 1: #!/usr/bin/env node
 2: import logger from "../lib/logger";
 3: import { scraperQueue } from "../queues/scraper.queue";
 4: import type {
 5: 	CompletedScraperJob,
 6: 	FailedScraperJob,
 7: 	ScraperJob,
 8: } from "../types/queue.types";
 9: async function checkQueueStatus() {
10: 	try {
11: 		logger.info("📊 Checking Scraper Queue Status...\n");
12: 		const [waiting, active, completed, failed, delayed, isPaused] =
13: 			await Promise.all([
14: 				scraperQueue.getWaiting(),
15: 				scraperQueue.getActive(),
16: 				scraperQueue.getCompleted(),
17: 				scraperQueue.getFailed(),
18: 				scraperQueue.getDelayed(),
19: 				scraperQueue.isPaused(),
20: 			]);
21: 		const counts = {
22: 			waiting: waiting.length,
23: 			active: active.length,
24: 			completed: completed.length,
25: 			failed: failed.length,
26: 			delayed: delayed.length,
27: 			paused: isPaused ? 1 : 0,
28: 		};
29: 		logger.info("=".repeat(60));
30: 		logger.info("📈 QUEUE SUMMARY");
31: 		logger.info("=".repeat(60));
32: 		logger.info(`⏳ Waiting:   ${counts.waiting}`);
33: 		logger.info(`⚡ Active:    ${counts.active}`);
34: 		logger.info(`✅ Completed: ${counts.completed}`);
35: 		logger.info(`❌ Failed:    ${counts.failed}`);
36: 		logger.info(`⏸️  Delayed:   ${counts.delayed}`);
37: 		logger.info(`⏸️  Paused:    ${counts.paused}`);
38: 		logger.info("=".repeat(60));
39: 		logger.info(
40: 			`📊 Total:     ${counts.waiting + counts.active + counts.completed + counts.failed + counts.delayed + counts.paused}`,
41: 		);
42: 		logger.info("=".repeat(60));
43: 		if (active.length > 0) {
44: 			logger.info("\n⚡ ACTIVE JOBS:");
45: 			for (const job of active.slice(0, 5)) {
46: 				const typedJob = job as ScraperJob;
47: 				logger.info(
48: 					`  Job ${typedJob.id}: "${typedJob.data.searchTerm}" (Progress: ${typedJob.progress}%)`,
49: 				);
50: 			}
51: 			if (active.length > 5) {
52: 				logger.info(`  ... and ${active.length - 5} more`);
53: 			}
54: 		}
55: 		if (completed.length > 0) {
56: 			logger.info("\n✅ RECENT COMPLETED JOBS (last 10):");
57: 			for (const job of completed.slice(-10).reverse()) {
58: 				const typedJob = job as CompletedScraperJob;
59: 				const propertiesCount = typedJob.returnvalue?.count || 0;
60: 				logger.info(
61: 					`  Job ${typedJob.id}: "${typedJob.data.searchTerm}" → ${propertiesCount} properties`,
62: 				);
63: 			}
64: 		}
65: 		if (failed.length > 0) {
66: 			logger.info("\n❌ RECENT FAILED JOBS (last 5):");
67: 			for (const job of failed.slice(-5).reverse()) {
68: 				const typedJob = job as FailedScraperJob;
69: 				const failedReason = typedJob.failedReason || "Unknown error";
70: 				logger.info(
71: 					`  Job ${typedJob.id}: "${typedJob.data.searchTerm}" - ${failedReason.substring(0, 80)}`,
72: 				);
73: 			}
74: 		}
75: 		if (waiting.length > 0) {
76: 			logger.info("\n⏳ NEXT WAITING JOBS (first 10):");
77: 			for (const job of waiting.slice(0, 10)) {
78: 				const typedJob = job as ScraperJob;
79: 				const priority = typedJob.opts.priority || 3;
80: 				logger.info(
81: 					`  Job ${typedJob.id}: "${typedJob.data.searchTerm}" (Priority: ${priority})`,
82: 				);
83: 			}
84: 			if (waiting.length > 10) {
85: 				logger.info(`  ... and ${waiting.length - 10} more`);
86: 			}
87: 		}
88: 		logger.info("");
89: 		// Cleanup
90: 		await scraperQueue.close();
91: 		process.exit(0);
92: 	} catch (error) {
93: 		logger.error({ err: error }, "❌ Error checking queue status:");
94: 		process.exit(1);
95: 	}
96: }
97: checkQueueStatus();
</file>

<file path="check-unsearched-terms.ts">
 1: import { PrismaClient } from '@prisma/client';
 2: import { getAllSearchTerms } from './utils/list-all-search-terms';
 3: const prisma = new PrismaClient();
 4: async function check() {
 5:   const allTerms = getAllSearchTerms().all;
 6:   console.log('Total inventory terms:', allTerms.length);
 7:   const BATCH = 50;
 8:   const unsearched: string[] = [];
 9:   let checked = 0;
10:   for (let i = 0; i < allTerms.length; i += BATCH) {
11:     const batch = allTerms.slice(i, i + BATCH);
12:     const results = await Promise.all(
13:       batch.map(async (term) => {
14:         const rows = await prisma.$queryRawUnsafe<{ found: boolean }[]>(
15:           `SELECT EXISTS(SELECT 1 FROM properties WHERE search_term = $1 AND year = 2025) as found`,
16:           term,
17:         );
18:         return { term, found: rows[0].found };
19:       }),
20:     );
21:     for (const r of results) {
22:       if (!r.found) unsearched.push(r.term);
23:     }
24:     checked += batch.length;
25:     if (checked % 100 === 0) console.log(`  checked ${checked}/${allTerms.length}...`);
26:   }
27:   console.log('Searched:', allTerms.length - unsearched.length);
28:   console.log('Unsearched:', unsearched.length);
29:   if (unsearched.length > 0) {
30:     console.log('\nUnsearched terms:');
31:     for (const t of unsearched) {
32:       console.log(' ', t);
33:     }
34:   } else {
35:     console.log('\nAll inventory terms have been searched for 2025.');
36:   }
37:   await prisma.$disconnect();
38: }
39: check().catch(console.error);
</file>

<file path="clear-all-jobs.ts">
 1: import winston from "winston";
 2: import { scraperQueue } from "../queues/scraper.queue";
 3: const logger = winston.createLogger({
 4: 	level: "info",
 5: 	format: winston.format.simple(),
 6: 	transports: [new winston.transports.Console()],
 7: });
 8: async function clearAllJobs() {
 9: 	try {
10: 		logger.info("Starting to clear all jobs from the queue...");
11: 		const counts = await scraperQueue.getJobCounts();
12: 		logger.info("Current job counts:", counts);
13: 		await scraperQueue.empty();
14: 		logger.info("Cleared waiting and delayed jobs");
15: 		await scraperQueue.clean(0, "completed");
16: 		logger.info("Cleaned all completed jobs");
17: 		await scraperQueue.clean(0, "failed");
18: 		logger.info("Cleaned all failed jobs");
19: 		const activeJobs = await scraperQueue.getActive();
20: 		for (const job of activeJobs) {
21: 			await job.remove();
22: 		}
23: 		logger.info(`Removed ${activeJobs.length} active jobs`);
24: 		const finalCounts = await scraperQueue.getJobCounts();
25: 		logger.info("Final job counts:", finalCounts);
26: 		logger.info("Successfully cleared all jobs from the queue");
27: 		process.exit(0);
28: 	} catch (error) {
29: 		logger.error("Error clearing jobs:", error);
30: 		process.exit(1);
31: 	}
32: }
33: clearAllJobs();
