 62: 			try {
 63: 				await job.remove();
 64: 				removedCount++;
 65: 			} catch (error) {
 66: 				logger.error(
 67: 					`Failed to remove job ${job.id}: ${getErrorMessage(error)}`,
 68: 				);
 69: 			}
 70: 		}
 71: 		logger.info(`✅ Removed ${removedCount} failed jobs\n`);
 72: 		const searchTerms = ENTITY_TERMS.slice(0, 50);
 73: 		logger.info(
 74: 			`Queuing ${searchTerms.length} high-yield entity term searches...\n`,
 75: 		);
