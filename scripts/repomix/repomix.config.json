{
	"$schema": "https://repomix.com/schemas/latest/schema.json",
	"input": {
		"maxFileSize": 52428800
	},
	"output": {
		"filePath": "summary.xml",
		"style": "xml",
		"parsableStyle": false,
		"fileSummary": true,
		"directoryStructure": true,
		"files": true,
		"removeComments": true,
		"removeEmptyLines": true,
		"compress": false,
		"showLineNumbers": true,
		"truncateBase64": false,
		"copyToClipboard": false,
		"includeFullDirectoryStructure": false
	},
	"include": ["**/*"],
	"ignore": {
		"useGitignore": true,
		"useDefaultPatterns": true,
		"customPatterns": [
			"docs/**",
			".git/**",
			"node_modules/**",
			"dist/**",
			"build/**",
			"coverage/**",
			".next/**",
			".turbo/**",
			".cache/**",
			".idea/**",
			".vscode/**",

			"*.log",
			".DS_Store",
			"Thumbs.db",

			".env",
			".env.*",

			"**repomix.config.json",
			"**repomix.config.jsonc",
			"**repomix.config.json5",
			"**repomix.config.js",
			"**repomix.config.mjs",
			"**repomix.config.cjs",
			"**repomix.config.ts",
			"**repomix.config.mts",
			"**repomix.config.cts",

			"**repomix-instruction.md",

			"**repomix-output.*",
			"**repomix-output.*.*",
			"repomix-*.xml",
			"repomix-*.md",
			"repomix-*.json",
			"repomix-*.txt",

			".repomix/**"
		]
	},
	"security": {
		"enableSecurityCheck": true
	},
	"tokenCount": {
		"encoding": "o200k_base"
	}
}
