{
	"compilerOptions": {
		"target": "ES2022",
		"module": "commonjs",
		"moduleResolution": "node",
		"esModuleInterop": true,
		"allowSyntheticDefaultImports": true,
		"strict": true,
		"skipLibCheck": true,
		"resolveJsonModule": true,
		"outDir": "../dist/scripts",
		"rootDir": "..",
		"baseUrl": ".",
		"paths": {
			"@shared/*": ["../shared/*"],
			"@prisma/client": ["../server/node_modules/@prisma/client"]
		}
	},
	"include": ["**/*.ts", "../utils/**/*.ts"],
	"exclude": ["node_modules"]
}
